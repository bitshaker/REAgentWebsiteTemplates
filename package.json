{
  "name": "re-agent-website-templates",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "create-site": "node scripts/create-site.mjs",
    "content:new": "node --env-file-if-exists=.env scripts/content.mjs new",
    "content:generate": "node --env-file-if-exists=.env scripts/content.mjs generate",
    "content:publish": "node scripts/content.mjs publish",
    "verify:launch": "node scripts/verify-launch.mjs",
    "format": "prettier --write .",
    "test:exports": "node tests/export-builds.mjs",
    "build:catalog": "astro build && node scripts/package-catalog.mjs",
    "verify:catalog": "node scripts/verify-catalog.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^5.9.3"
  }
}
