---
import HomeAgent from '../../src/components/HomeAgent.astro';
import { agent } from '../../src/lib/agent';
import { designHref } from '../../src/lib/design-pages';
import CinematicMedia from '../../src/components/CinematicMedia.astro';
import hero from './media/hero.jpg?url';
import detail1 from './media/detail-1.jpg?url';
import detail2 from './media/detail-2.jpg?url';
import detail3 from './media/detail-3.jpg?url';
import detail4 from './media/detail-4.jpg?url';
import poster from './media/poster.jpg?url';
import film from './media/film.mp4?url';
interface Props {
  previewBase?: string;
}
const { previewBase = '' } = Astro.props;
const href = (path: string) => designHref(path, previewBase);
---

<div class="solstice-home collection-home">
  <section class="solstice-hero">
    <CinematicMedia src={film} poster={poster} />
    <div class="solstice-overlay"></div>
    <div class="solstice-hero-copy" data-reveal>
      <p class="solstice-label">A sense of place / {agent.market}</p>
      <h1>
        Live beautifully,
        <br />
        <em>wherever you are.</em>
      </h1>
      <p>Real estate for the life you imagine.</p>
      <a class="solstice-pill light" href="#solstice-welcome">
        Discover the story <span>↓</span>
      </a>
    </div>
    <span class="solstice-hero-caption">
      A study in living · Illustrative film
    </span>
  </section>
  <HomeAgent {previewBase} design="solstice" />
  <section class="solstice-welcome" id="solstice-welcome" data-reveal>
    <p class="solstice-label">A warmer welcome</p>
    <h2>
      There’s a certain feeling
      <br />
      when you’ve found <em>your place.</em>
    </h2>
    <div class="solstice-welcome-bottom">
      <p>
        It begins with a conversation. Whether you’re finding a new home or
        preparing for what comes next, {agent.name} is here to help you navigate
        the journey with intention.
      </p>
      <a class="solstice-pill" href={href('/about/')}>
        Our approach <span>↗</span>
      </a>
    </div>
  </section>
  <section class="solstice-arch-section">
    <div class="solstice-arch-copy" data-reveal>
      <p class="solstice-label">The art of arriving / 01</p>
      <h2>
        Make space for
        <br />
        <em>more life.</em>
      </h2>
      <p>
        A quiet morning. An open door. The feeling of belonging somewhere. The
        details that matter are different for everyone; let’s discover yours.
      </p>
      <a class="solstice-pill" href={href('/buyers/')}>
        Explore buying <span>↗</span>
      </a>
    </div>
    <figure class="solstice-arch">
      <img src={hero} alt="" loading="lazy" data-parallax />
      <figcaption>A study in living · Illustrative scene</figcaption>
    </figure>
  </section>
  <section class="solstice-stories" aria-labelledby="solstice-stories-title">
    <div class="solstice-stories-head">
      <div>
        <p class="solstice-label">Notes on living / 02</p>
        <h2 id="solstice-stories-title">
          A slower look <em>around.</em>
        </h2>
      </div>
      <p>
        Light, texture, and places to pause. An editorial collection of
        illustrative scenes.
      </p>
    </div>
    <div
      class="solstice-track"
      tabindex="0"
      aria-label="Editorial image stories"
    >
      {[detail1, detail2, detail3, detail4].map((image, i) => (
        <figure>
          <img src={image} alt="" loading="lazy" />
          <figcaption>
            <span>0{i + 1} / A study in living</span>
            <span>Illustrative scene</span>
          </figcaption>
        </figure>
      ))}
    </div>
    <div class="solstice-controls">
      <span data-gallery-count aria-live="polite">
        Scene 01 of 04
      </span>
      <div>
        <button type="button" data-solstice-prev aria-label="Previous image">
          ←
        </button>
        <button type="button" data-solstice-next aria-label="Next image">
          →
        </button>
      </div>
    </div>
  </section>
  <section class="solstice-paths" data-reveal>
    <p class="solstice-label">For every next chapter</p>
    <h2>
      Where will yours
      <br />
      <em>take you?</em>
    </h2>
    <div>
      <a href={href('/buyers/')}>
        <span>01 / Find a place</span>
        <strong>Buying a home</strong>
        <span>↗</span>
      </a>
      <a href={href('/sellers/')}>
        <span>02 / Make a move</span>
        <strong>Selling a home</strong>
        <span>↗</span>
      </a>
      <a href={href('/blog/')}>
        <span>03 / Take a moment</span>
        <strong>Read the journal</strong>
        <span>↗</span>
      </a>
    </div>
  </section>
  <section class="solstice-end" data-reveal>
    <p class="solstice-label">Your next chapter awaits</p>
    <h2>
      Let’s begin
      <br />
      <em>somewhere beautiful.</em>
    </h2>
    <a class="solstice-pill light" href={href('/contact/')}>
      Start a conversation <span>↗</span>
    </a>
  </section>
</div>
<script>
  document.querySelectorAll('.solstice-stories').forEach((gallery) => {
    const track = gallery.querySelector('.solstice-track');
    const scroll = (direction: number) => {
      if (!track) return;
      const behavior = matchMedia('(prefers-reduced-motion: reduce)').matches
        ? 'auto'
        : 'smooth';
      track.scrollBy({ left: direction * track.clientWidth * 0.7, behavior });
    };
    gallery
      .querySelector('[data-solstice-prev]')
      ?.addEventListener('click', () => scroll(-1));
    gallery
      .querySelector('[data-solstice-next]')
      ?.addEventListener('click', () => scroll(1));
    track?.addEventListener(
      'scroll',
      () => {
        const figures = Array.from(track.querySelectorAll('figure'));
        const first = figures[0];
        if (!first) return;
        const position =
          track.getBoundingClientRect().left +
          (first.getBoundingClientRect().left -
            track.getBoundingClientRect().left +
            track.scrollLeft);
        const index = figures.reduce(
          (closest, figure, i) =>
            Math.abs(figure.getBoundingClientRect().left - position) <
            Math.abs(figures[closest].getBoundingClientRect().left - position)
              ? i
              : closest,
          0,
        );
        const count = gallery.querySelector('[data-gallery-count]');
        if (count)
          count.textContent = `Scene ${String(index + 1).padStart(2, '0')} of 04`;
      },
      { passive: true },
    );
  });
</script>
