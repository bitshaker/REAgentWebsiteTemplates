---
import AgentPortrait from '../../src/components/AgentPortrait.astro';
import { agent } from '../../src/lib/agent';
import { designHref } from '../../src/lib/design-pages';
import buyers from './media/interior-bright.webp?url';
import sellers from './media/modern-dusk-lit.webp?url';
import about from './media/construction.webp?url';
import blog from './media/team.webp?url';

interface Props {
  previewBase?: string;
}
const { previewBase = '' } = Astro.props;
const doors = [
  {
    title: 'Buy',
    page: 'buyers',
    image: buyers,
    text: 'Plan your home search',
  },
  {
    title: 'Sell',
    page: 'sellers',
    image: sellers,
    text: 'Prepare for your sale',
  },
  { title: 'Meet', page: 'about', image: about, text: 'Meet your agent' },
  { title: 'Explore', page: 'blog', image: blog, text: 'Read the journal' },
];
---

<section class="section">
  <div class="wrap">
    <p class="eyebrow">
      {agent.name} / {agent.market}
    </p>
    <h1>Which door is yours?</h1>
    <p>Four ways to begin your next chapter.</p>
    <ul
      class="doors scroll-art"
      role="list"
      aria-label="Four ways to get started"
    >
      {doors.map(({ title, page, image, text }, i) => (
        <li>
          <a href={designHref(`/${page}/`, previewBase)}>
            <img src={image} alt="" />
            <span class="door-label">
              <span class="eyebrow">0{i + 1}</span>
              <strong>{title}</strong>
              <span>{text} ↗</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
<section class="section">
  <div class="wrap split">
    <h2>Start with a conversation.</h2>
    <div>
      <AgentPortrait />
      <p>{agent.bio}</p>
      <a class="button" href={designHref('/contact/', previewBase)}>
        Get in touch ↗
      </a>
    </div>
  </div>
</section>

<style>
  .doors {
    display: flex;
    gap: 10px;
    list-style: none;
    padding: 0;
  }
  li {
    flex: 1;
    min-width: 0;
    transition: flex 350ms ease;
  }
  li:hover,
  li:focus-within {
    flex: 1.55;
  }
  .doors a {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: clamp(340px, 48vw, 570px);
    padding: clamp(14px, 2vw, 32px);
    background: #36261f;
    color: #fff7ec;
    text-decoration: none;
  }
  .doors a:focus-visible {
    outline-offset: -4px;
    outline-color: #fff7ec;
  }
  .doors img,
  .doors a::before {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .doors img {
    object-fit: cover;
    z-index: -2;
  }
  .doors a::before {
    content: '';
    z-index: -1;
    background: linear-gradient(transparent 24%, #22140de8 90%);
  }
  .door-label {
    display: grid;
    gap: 4px;
  }
  .door-label strong {
    font: 400 clamp(1.65rem, 3vw, 3rem)/1.1 var(--display);
  }
  @media (max-width: 760px) {
    .doors {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 73%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 12px;
    }
    li {
      scroll-snap-align: start;
    }
    .doors a {
      min-height: 310px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    li {
      transition: none;
    }
  }
</style>
