---
import AgentPortrait from '../../src/components/AgentPortrait.astro';
import { agent } from '../../src/lib/agent';
import { designHref } from '../../src/lib/design-pages';

interface Props {
  previewBase?: string;
}
const { previewBase = '' } = Astro.props;
---

<div class="constellation">
  <div class="sky" aria-hidden="true">
    <canvas width="400" height="400" data-stars></canvas>
  </div>
  <div class="wrap">
    <section class="step" data-constellation="0">
      <div class="glass">
        <p class="eyebrow">
          {agent.name} / {agent.market}
        </p>
        <h1>Find your bearings.</h1>
        <p>
          Get to know the steps, the questions to ask, and the person who can
          guide you through your next move.
        </p>
      </div>
    </section>
    <section class="step" data-constellation="1">
      <div class="glass">
        <p class="eyebrow">01 / Buy</p>
        <h2>Find a place of your own.</h2>
        <a class="button" href={designHref('/buyers/', previewBase)}>
          Explore the buyer guide ↗
        </a>
      </div>
    </section>
    <section class="step" data-constellation="2">
      <div class="glass">
        <p class="eyebrow">02 / Sell</p>
        <h2>Make a plan for what’s next.</h2>
        <a class="button" href={designHref('/sellers/', previewBase)}>
          Explore the seller guide ↗
        </a>
      </div>
    </section>
    <section class="step">
      <div class="glass">
        <p class="eyebrow">03 / Connect</p>
        <h2>Meet {agent.name}.</h2>
        <AgentPortrait />
        <p>{agent.bio}</p>
        <a class="button" href={designHref('/contact/', previewBase)}>
          Start a conversation ↗
        </a>
      </div>
    </section>
  </div>
</div>

<style>
  .constellation {
    isolation: isolate;
    display: grid;
    background: radial-gradient(ellipse at 70% 35%, #1a3a30, #07100d 72%);
  }
  .constellation > * {
    grid-area: 1 / 1;
  }
  .constellation .wrap {
    width: 100%;
  }
  .sky {
    position: sticky;
    top: 0;
    align-self: start;
    height: 100svh;
    display: grid;
    place-items: center end;
    padding-right: 6%;
    pointer-events: none;
    background:
      radial-gradient(circle at 40% 60%, #8cdec233 1px, transparent 1.5px) 10px
        20px / 57px 61px,
      radial-gradient(circle at 30% 40%, #8cdec244 1px, transparent 1.5px) 0 0 /
        99px 103px;
  }
  canvas {
    width: min(49vw, 610px);
    height: auto;
  }
  .step {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 70svh;
    padding-block: 40px;
  }
  .glass {
    width: min(54%, 620px);
    padding: clamp(22px, 4vw, 50px);
    background: #0b1915e8;
    border: 1px solid var(--line);
    border-radius: 14px;
  }
  .glass h1,
  .glass h2 {
    color: var(--accent);
  }
  @media (max-width: 760px) {
    .sky {
      place-items: start center;
      padding: 4svh 0 0;
    }
    canvas {
      width: min(66vw, 330px);
    }
    .step {
      align-items: end;
      min-height: 75svh;
    }
    .glass {
      width: 100%;
    }
  }
</style>

<script>
  import { sample } from './shapes';
  import { key, sold, network } from './figures';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-stars]');
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const figures = [network, key, sold].map((draw) => sample(draw, 1200));
    const points = figures[0].slice();
    let target = figures[0];
    let frame = 0;

    function paint() {
      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = '#9ff3d4';
      for (let i = 0; i < points.length; i += 3) {
        const x = ((points[i] + 1) * canvas.width) / 2;
        const y = ((1 - points[i + 1]) * canvas.height) / 2;
        ctx.globalAlpha = 0.35 + (i % 23) / 36;
        ctx.fillRect(x, y, 1.5, 1.5);
      }
    }

    function morph() {
      let moving = false;
      for (let i = 0; i < points.length; i++) {
        const delta = target[i] - points[i];
        moving ||= Math.abs(delta) > 0.003;
        points[i] += delta * 0.09;
      }
      paint();
      if (moving) frame = requestAnimationFrame(morph);
    }

    paint();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          target =
            figures[
              Number((entry.target as HTMLElement).dataset.constellation)
            ];
          cancelAnimationFrame(frame);
          if (reducedMotion.matches) {
            points.set(target);
            paint();
          } else {
            frame = requestAnimationFrame(morph);
          }
        }
      },
      { rootMargin: '-42% 0px -42% 0px' },
    );
    document
      .querySelectorAll('[data-constellation]')
      .forEach((step) => observer.observe(step));
  }
</script>
