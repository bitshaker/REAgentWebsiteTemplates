---
import { agent } from '../../src/lib/agent';
import { designHref } from '../../src/lib/design-pages';
import AgentInvitation from '../../src/components/AgentInvitation.astro';
import exterior from './media/exterior.webp?url';
import interior from './media/interior.jpg?url';
interface Props {
  previewBase?: string;
}
const { previewBase = '' } = Astro.props;
---

<section class="studio">
  <header class="cover">
    <img
      src={exterior}
      alt="Illustrative green house with a timber front door"
      fetchpriority="high"
    />
    <div class="cover-inner wrap">
      <p class="eyebrow">The Listing Studio · {agent.name}</p>
      <h1>
        Every home
        <br /> has a <em>story.</em>
      </h1>
      <a href="#sample-campaign">See a sample campaign ↓</a>
    </div>
    <p class="credit eyebrow">Illustrative property · Not for sale</p>
  </header>
  <div class="section wrap" id="sample-campaign">
    <div class="edition eyebrow">
      <span>Studio Notes / Vol. 01</span>
      <span>Illustrative campaign</span>
    </div>
    <div class="editorial">
      <div class="story">
        <p class="eyebrow">From first look to launch</p>
        <h2>Let the details do the talking.</h2>
        <p>
          See how preparation and presentation can help someone understand what
          makes a home worth a closer look.
        </p>
      </div>
      <figure class="proof">
        <img
          src={interior}
          alt="Illustrative living room with neutral furnishings"
          width="1100"
          height="619"
          loading="lazy"
        />
        <figcaption class="eyebrow">
          <span>01 / Interior study</span>
          <span>Independent reference image</span>
        </figcaption>
      </figure>
    </div>

    <fieldset class="workbench">
      <legend>Explore the process</legend>
      <label>
        <input type="radio" name="studio-view" value="campaign" checked /> The
        campaign
      </label>
      <label>
        <input type="radio" name="studio-view" value="preparation" /> The
        preparation
      </label>
      <label>
        <input type="radio" name="studio-view" value="tour" /> The buyer’s tour
      </label>

      <div class="spread campaign">
        <div class="campaign-image">
          <img src={exterior} alt="" loading="lazy" />
        </div>
        <div class="spread-copy">
          <p class="eyebrow">01 / Sample creative</p>
          <h3>A welcome in the woods.</h3>
          <p>
            Lead with the arrival, show how the rooms connect, and give buyers
            the practical information they need to decide whether to visit.
          </p>
          <a href={designHref('/sellers/', previewBase)}>
            See the selling process ↗
          </a>
        </div>
      </div>
      <div class="spread preparation">
        <div class="spread-copy">
          <p class="eyebrow">02 / Before the camera arrives</p>
          <h3>Make a plan for the first impression.</h3>
          <p>
            Walk through the home together and decide which repairs, styling,
            and photo angles are worth your time.
          </p>
          <a href={designHref('/sellers/', previewBase)}>
            Plan your preparation ↗
          </a>
        </div>
        <ol class="checklist">
          <li>Walkthrough and priorities</li>
          <li>Photo plan and property details</li>
          <li>Launch timing and next steps</li>
        </ol>
      </div>
      <div class="spread tour">
        <div class="plan">
          <svg
            viewBox="0 0 320 185"
            role="img"
            aria-label="Illustrative layout with an entry, kitchen, and living room"
          >
            <path
              d="M32 155V25h256v130H160m-24 0H32m85-130v70m0 22v38m0-77h51m23 0h97m-84 0v77"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
            />
            <path
              d="M136 155v-24a24 24 0 0 1 24 24M117 117h22a22 22 0 0 0-22-22"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            />
            <g fill="currentColor" font-size="11" font-family="system-ui">
              <text x="46" y="79">
                LIVING
              </text>
              <text x="205" y="57">
                KITCHEN
              </text>
              <text x="151" y="118">
                ENTRY
              </text>
            </g>
          </svg>
          <p class="eyebrow">Sample floor plan · Not to scale</p>
        </div>
        <div class="spread-copy">
          <p class="eyebrow">03 / A closer look</p>
          <h3>Picture an ordinary day here.</h3>
          <p>
            Trace your route from the front door to the kitchen. Where do
            groceries go? Which rooms get daylight when you use them?
          </p>
          <a href={designHref('/buyers/', previewBase)}>
            Prepare for your next tour ↗
          </a>
        </div>
      </div>
    </fieldset>
  </div>
</section>
<AgentInvitation {previewBase} />

<style>
  .cover {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: clamp(440px, 68vw, 720px);
    color: var(--paper);
    background: var(--scrim);
  }
  .cover img,
  .cover::after {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
  }
  .cover::after {
    content: '';
    background: linear-gradient(
      0deg,
      var(--scrim),
      color-mix(in srgb, var(--scrim) 50%, transparent) 62%,
      transparent
    );
  }
  .cover-inner {
    width: 100%;
    padding-block: 40px 72px;
  }
  .cover h1 {
    margin-bottom: 12px;
  }
  .cover em,
  .cover .eyebrow {
    color: var(--signal);
  }
  .cover a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .cover a:focus-visible {
    outline-color: var(--signal);
  }
  .credit {
    position: absolute;
    bottom: 14px;
    right: 5%;
    margin: 0;
    font-size: 0.6rem;
  }
  .edition {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 6px 14px;
    border-block: 1px solid var(--ink);
    padding-block: 10px;
    margin-bottom: 30px;
  }
  .editorial {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: clamp(16px, 5vw, 76px);
    align-items: center;
  }
  .story h2 {
    margin-bottom: 16px;
  }
  .proof {
    margin: 0;
  }
  .proof img {
    width: 100%;
    height: auto;
    aspect-ratio: 16/9;
    object-fit: cover;
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 5px 15px;
    margin-top: 10px;
    font-size: 0.63rem;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .proof {
        animation: develop linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 95%;
      }
      @keyframes develop {
        from {
          clip-path: inset(10% 9%);
          transform: translateY(30px);
        }
        to {
          clip-path: inset(0);
          transform: translateY(0);
        }
      }
    }
  }
  .workbench {
    padding: 0;
    border: 0;
    margin: 34px 0 0;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  legend {
    font-weight: 750;
    font-size: 0.8rem;
    margin-bottom: 8px;
  }
  label {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 5px 12px;
    cursor: pointer;
    border: 1px solid var(--line);
    font-size: 0.9rem;
  }
  label:has(:checked) {
    background: var(--ink);
    color: var(--paper);
  }
  label:has(:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }
  input {
    accent-color: var(--accent);
  }
  .spread {
    display: none;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    width: 100%;
    border: 1px solid var(--line);
    background: var(--wash);
  }
  .workbench:has([value='campaign']:checked) .campaign,
  .workbench:has([value='preparation']:checked) .preparation,
  .workbench:has([value='tour']:checked) .tour {
    display: grid;
    animation: print-in 0.35s ease-out both;
  }
  @keyframes print-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  .spread-copy,
  .checklist,
  .plan {
    padding: clamp(16px, 4vw, 58px);
  }
  .spread-copy h3 {
    font-size: clamp(1.75rem, 3vw, 3rem);
    margin-bottom: 12px;
  }
  .spread-copy a {
    display: inline-block;
    padding-block: 8px;
  }
  .campaign-image {
    height: 100%;
  }
  .campaign-image img {
    width: 100%;
    height: 100%;
    min-height: 230px;
    object-fit: cover;
  }
  .checklist {
    list-style-position: inside;
    margin: 0;
  }
  .checklist li {
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }
  .plan svg {
    display: block;
    width: 100%;
    background: var(--paper);
  }
  .plan p {
    margin: 10px 0 0;
  }
  @media (max-width: 760px) {
    .editorial,
    .spread {
      grid-template-columns: 1fr;
    }
    .cover img {
      object-position: 54% center;
    }
    .campaign-image img {
      max-height: 290px;
    }
    .workbench label {
      flex: 1 1 42%;
    }
  }
</style>
