---
import HomeAgent from '../../src/components/HomeAgent.astro';
import { agent } from '../../src/lib/agent';
import { designHref } from '../../src/lib/design-pages';
import CinematicMedia from '../../src/components/CinematicMedia.astro';
import hero from './media/hero.jpg?url';
import detail1 from './media/detail-1.jpg?url';
import detail2 from './media/detail-2.jpg?url';
import detail3 from './media/detail-3.jpg?url';
import detail4 from './media/detail-4.jpg?url';
import film from './media/film.mp4?url';
import poster from './media/poster.jpg?url';
interface Props {
  previewBase?: string;
}
const { previewBase = '' } = Astro.props;
---

<div class="atelier-home collection-home">
  <section class="a-hero">
    <CinematicMedia src={film} poster={poster} />
    <div class="a-hero-overlay"></div>
    <div class="a-hero-meta">
      <span>{agent.market}</span>
      <span>Real estate / A personal perspective</span>
    </div>
    <h1>
      The art of
      <br />
      <em>being home.</em>
    </h1>
    <div class="a-hero-foot">
      <span>With {agent.name}</span>
      <a href="#a-story">Discover ↓</a>
    </div>
  </section>
  <HomeAgent {previewBase} design="atelier" />
  <section class="a-story a-wrap" id="a-story">
    <div class="a-story-label">
      <p>01 / THE APPROACH</p>
      <span>Thoughtful by nature.</span>
    </div>
    <div data-reveal>
      <h2>
        Places shape
        <br />
        <em>our stories.</em>
      </h2>
      <div class="a-story-bottom">
        <p>
          Finding or selling a home is a personal endeavor. A clear perspective
          and attentive guidance can help you make your next move with
          intention.
        </p>
        <a href={designHref('/about/', previewBase)}>
          The person behind the practice ↗
        </a>
      </div>
    </div>
  </section>
  <section class="a-image-feature">
    <img src={hero} alt="" loading="lazy" data-parallax />
    <div>
      <span>AN EYE FOR THE EVERYDAY</span>
      <h2>
        Life, beautifully
        <br />
        <em>considered.</em>
      </h2>
    </div>
  </section>
  <section class="a-services a-wrap">
    <div class="a-section-head">
      <p>02 / YOUR NEXT MOVE</p>
      <h2>
        Two paths.
        <br />
        <em>One purpose.</em>
      </h2>
    </div>
    <div class="a-services-grid">
      <a href={designHref('/buyers/', previewBase)} data-reveal>
        <img src={detail1} alt="" loading="lazy" />
        <div>
          <span>01 / BUYING</span>
          <h3>
            Find a place
            <br />
            <em>to belong.</em>
          </h3>
          <b>↗</b>
        </div>
      </a>
      <a href={designHref('/sellers/', previewBase)} data-reveal>
        <img src={detail2} alt="" loading="lazy" />
        <div>
          <span>02 / SELLING</span>
          <h3>
            Make space
            <br />
            <em>for what’s next.</em>
          </h3>
          <b>↗</b>
        </div>
      </a>
    </div>
  </section>
  <section class="a-journal">
    <div class="a-journal-art">
      <img src={detail3} alt="" loading="lazy" />
      <img src={detail4} alt="" loading="lazy" />
    </div>
    <div class="a-journal-copy" data-reveal>
      <p>03 / THE JOURNAL</p>
      <h2>
        Notes on
        <br />
        <em>home &amp; living.</em>
      </h2>
      <p>Ideas and perspectives to accompany your next chapter.</p>
      <a href={designHref('/blog/', previewBase)}>Explore the journal ↗</a>
    </div>
  </section>
  <section class="a-contact a-wrap">
    <p>04 / BEGIN A CONVERSATION</p>
    <h2>
      Let’s make
      <br />
      <em>something move.</em>
    </h2>
    <a href={designHref('/contact/', previewBase)}>
      Get in touch <span>↗</span>
    </a>
  </section>
</div>
