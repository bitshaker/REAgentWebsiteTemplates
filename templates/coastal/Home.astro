---
import { agent } from '../../src/lib/agent';
import Services from '../../src/components/Services.astro';
---

<section class="coastal-hero">
  <div class="wrap split">
    <div>
      <p class="eyebrow">Rooted in {agent.market}</p>
      <h1>
        A thoughtful move.
        <br />
        <em>
          A place of
          <br />
          your own.
        </em>
      </h1>
      <p class="intro">
        A home is more than your next address. Find your way forward with
        personal guidance, a clear plan, and someone in your corner.
      </p>
      <a class="button" href="/contact/">
        Let's talk about your next chapter ↗
      </a>
      <p class="coastal-note">
        {agent.name} · {agent.role}
      </p>
    </div>
    <div class="hero-frame">
      <img
        class="hero-art"
        src="/images/architecture.svg"
        alt="Illustration of a sunlit home framed by garden planting"
        width="900"
        height="1000"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
<section class="section coastal-about">
  <div class="wrap split">
    <p class="eyebrow">
      A local perspective.
      <br />A personal approach.
    </p>
    <div>
      <h2>
        Big decisions deserve
        <br />
        thoughtful guidance.
      </h2>
      <p>{agent.bio}</p>
      <a href="/about/">Get to know {agent.name} ↗</a>
    </div>
  </div>
</section>
<Services />
