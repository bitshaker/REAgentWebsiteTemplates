---
import { sitePath } from '../../src/lib/site';
import AgentPortrait from '../../src/components/AgentPortrait.astro';
import { agent } from '../../src/lib/agent';
import { designHref } from '../../src/lib/design-pages';
import Services from '../../src/components/Services.astro';
interface Props {
  previewBase?: string;
}
const { previewBase = '' } = Astro.props;
---

<section class="coastal-hero">
  <div class="wrap split">
    <div>
      <p class="eyebrow">Rooted in {agent.market}</p>
      <h1>
        A thoughtful move.
        <br />
        <em>
          A place of
          <br />
          your own.
        </em>
      </h1>
      <p class="intro">
        A home is more than your next address. Find your way forward with
        personal guidance, a clear plan, and someone in your corner.
      </p>
      <a class="button" href={designHref('/contact/', previewBase)}>
        Let's talk about your next chapter ↗
      </a>
      <p class="coastal-note">
        {agent.name} · {agent.role}
      </p>
    </div>
    <div class="hero-frame scroll-art">
      <img
        class="hero-art"
        src={sitePath('/images/architecture.svg')}
        alt="Illustration of a sunlit home framed by garden planting"
        width="900"
        height="1000"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
<section class="section coastal-about">
  <div class="wrap split">
    <p class="eyebrow">
      A local perspective.
      <br />A personal approach.
    </p>
    <div>
      <h2>
        Big decisions deserve
        <br />
        thoughtful guidance.
      </h2>
      <AgentPortrait />
      <p>{agent.bio}</p>
      <a href={designHref('/about/', previewBase)}>
        Get to know {agent.name} ↗
      </a>
    </div>
  </div>
</section>
<Services {previewBase} />
