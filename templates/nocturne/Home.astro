---
import { optimizedArt } from '../../src/lib/media';
import HomeAgent from '../../src/components/HomeAgent.astro';
import CinematicMedia from '../../src/components/CinematicMedia.astro';
import { agent, phoneHref } from '../../src/lib/agent';
import { designHref } from '../../src/lib/design-pages';
import film from './media/film.mp4?url';
import posterSource from './media/poster.jpg';
import oneSource from './media/detail-1.jpg';
import twoSource from './media/detail-2.jpg';
import threeSource from './media/detail-3.jpg';
import fourSource from './media/detail-4.jpg';
const poster = await optimizedArt(posterSource, '', false);
const one = await optimizedArt(oneSource, '');
const two = await optimizedArt(twoSource, '');
const three = await optimizedArt(threeSource, '');
const four = await optimizedArt(fourSource, '');
interface Props {
  previewBase?: string;
}
const { previewBase = '' } = Astro.props;
---

<div class="nocturne-home collection-home">
  <section class="nocturne-hero" aria-labelledby="nocturne-title">
    <div class="nocturne-film">
      <CinematicMedia hero src={film} poster={poster.src} />
    </div>
    <div class="nocturne-hero-copy" data-reveal>
      <h1 id="nocturne-title">
        The art of
        <br />
        <em>coming home.</em>
      </h1>
      <p class="nocturne-call-reason">
        Buying or selling in {agent.market}? A considered move begins with the
        right questions.
      </p>
      <a class="n-link" href={phoneHref}>
        Call to discuss your priorities <span>↗</span>
      </a>
    </div>
    <div class="nocturne-hero-foot">
      <span>Buying &amp; selling</span>
      <span>Homes &amp; the lives within them</span>
      <span>Scroll to explore ↓</span>
    </div>
  </section>
  <HomeAgent
    {previewBase}
    design="nocturne"
    invitation="Before choosing a home or a list date, ask what deserves a closer look: condition, preparation, timing, or the terms that matter to you."
    callLabel="Discuss the details by phone"
  />
  <section class="nocturne-intro n-wrap" data-reveal>
    <p class="n-label">01 / A considered perspective</p>
    <div>
      <h2>
        Some places simply <em>stay with you.</em>
      </h2>
      <p>
        A beautiful first impression is a starting point. How does the home work
        for you? What needs a closer look? Talk through your priorities before
        deciding which homes to explore.
      </p>
      <a class="n-link" href={designHref('/buyers/', previewBase)}>
        The buying journey <span>↗</span>
      </a>
    </div>
  </section>
  <section class="nocturne-spread n-wrap" aria-label="The details of home">
    <figure data-reveal>
      <img
        decoding="async"
        width={one.width}
        height={one.height}
        src={one.src}
        srcset={one.srcset}
        sizes="100vw"
        alt=""
        loading="lazy"
        data-n-scene-image
      />
      <figcaption>01 / Perspectives on home</figcaption>
      <div
        class="n-scene-controls"
        role="group"
        data-n-scene-controls
        hidden
        aria-label="Choose a scene"
      >
        <button
          type="button"
          data-scene-src={one.src}
          data-scene-srcset={one.srcset}
          aria-pressed="true"
        >
          01 / The view
        </button>
        <button
          type="button"
          data-scene-src={two.src}
          data-scene-srcset={two.srcset}
          aria-pressed="false"
        >
          02 / The interior
        </button>
      </div>
    </figure>
    <div class="nocturne-spread-side" data-reveal>
      <p class="n-label">A sense of place</p>
      <h2>
        Beautifully
        <br />
        <em>considered.</em>
      </h2>
      <img
        decoding="async"
        width={two.width}
        height={two.height}
        src={two.src}
        srcset={two.srcset}
        sizes="100vw"
        alt=""
        loading="lazy"
      />
      <p>
        Before a decision, ask about the details behind the first impression.
      </p>
      <ul class="nocturne-considerations">
        <li>Condition: what needs a professional inspection?</li>
        <li>Preparation: what should happen before listing?</li>
        <li>Terms: what matters alongside the price?</li>
      </ul>
      <a class="n-link" href={phoneHref}>
        Call with a question about the details ↗
      </a>
    </div>
  </section>
  <section class="nocturne-services" aria-labelledby="n-services" data-reveal>
    <div class="n-wrap">
      <p class="n-label">02 / How we can work together</p>
      <h2 id="n-services">
        A considered move,
        <br />
        <em>from beginning to end.</em>
      </h2>
      <div class="n-service-grid">
        <a href={designHref('/buyers/', previewBase)}>
          <span>01</span>
          <h3>Buying</h3>
          <p>
            Discuss your search criteria, tour questions, and the tradeoffs
            behind an offer.
          </p>
          <b>Explore buying ↗</b>
        </a>
        <a href={designHref('/sellers/', previewBase)}>
          <span>02</span>
          <h3>Selling</h3>
          <p>
            Ask about preparation, presentation, and the terms to consider
            alongside price.
          </p>
          <b>Explore selling ↗</b>
        </a>
      </div>
    </div>
  </section>
  <section class="nocturne-about n-wrap" data-reveal>
    <div class="n-about-photo">
      <img
        decoding="async"
        width={three.width}
        height={three.height}
        src={three.src}
        srcset={three.srcset}
        sizes="100vw"
        alt=""
        loading="lazy"
      />
    </div>
    <div>
      <p class="n-label">03 / Your guide</p>
      <h2>
        A personal
        <br />
        <em>point of view.</em>
      </h2>
      <p>
        Real estate is personal. {agent.name} is here to listen, understand your
        priorities, and help you navigate what comes next.
      </p>
      <a class="n-link" href={designHref('/about/', previewBase)}>
        Meet {agent.name} <span>↗</span>
      </a>
    </div>
    <div class="n-about-inset">
      <img
        decoding="async"
        width={four.width}
        height={four.height}
        src={four.src}
        srcset={four.srcset}
        sizes="100vw"
        alt=""
        loading="lazy"
      />
    </div>
  </section>
  <section class="nocturne-close">
    <p class="n-label">The next chapter starts here</p>
    <h2>
      Let’s make room
      <br />
      <em>for what’s next.</em>
    </h2>
    <p class="nocturne-call-note">
      What needs a closer look before you decide? Bring it to a conversation
      with {agent.name}.
    </p>
    <a class="n-link" href={phoneHref}>
      Call {agent.phone} · consider the next step <span>↗</span>
    </a>
  </section>
</div>

<script>
  const sceneControls = document.querySelector<HTMLElement>(
    '[data-n-scene-controls]',
  );
  const sceneImage = document.querySelector<HTMLImageElement>(
    '[data-n-scene-image]',
  );
  if (sceneControls && sceneImage) {
    sceneControls.hidden = false;
    sceneControls
      .querySelectorAll<HTMLButtonElement>('button')
      .forEach((button) => {
        button.addEventListener('click', () => {
          if (!button.dataset.sceneSrc) return;
          sceneImage.src = button.dataset.sceneSrc;
          sceneImage.srcset = button.dataset.sceneSrcset || '';
          sceneControls
            .querySelectorAll('button')
            .forEach((item) =>
              item.setAttribute('aria-pressed', String(item === button)),
            );
        });
      });
  }
</script>
