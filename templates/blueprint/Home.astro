---
import AgentPortrait from '../../src/components/AgentPortrait.astro';
import { agent } from '../../src/lib/agent';
import { designHref } from '../../src/lib/design-pages';
import House from './House.astro';

interface Props {
  previewBase?: string;
}
const { previewBase = '' } = Astro.props;
---

<div class="wrap blueprint" data-blueprint data-active="intro">
  <div class="blueprint-steps">
    <section class="blueprint-step" data-plan="intro">
      <p class="eyebrow">
        {agent.market} / {agent.name}
      </p>
      <h1>A blueprint for your next move.</h1>
      <p>
        Start with a plan for buying or selling. Scroll to see the elevation
        change with each sheet.
      </p>
      <a href="#blueprint-buy">Explore the plans ↓</a>
    </section>
    <section class="blueprint-step" id="blueprint-buy" data-plan="buy">
      <p class="eyebrow">01 / Buyer plan</p>
      <h2>Picture yourself inside.</h2>
      <p>Set your priorities, prepare for tours, and know what to look for.</p>
      <a href={designHref('/buyers/', previewBase)}>Open the buyer guide ↗</a>
    </section>
    <section class="blueprint-step" data-plan="sell">
      <p class="eyebrow">02 / Seller plan</p>
      <h2>Get ready for market.</h2>
      <p>Walk through preparation, pricing, and the steps to closing.</p>
      <a href={designHref('/sellers/', previewBase)}>Open the seller guide ↗</a>
    </section>
  </div>
  <figure class="blueprint-drawing">
    <House />
    <figcaption>
      FIG. 01 <span>RESIDENTIAL ELEVATION</span>
    </figcaption>
  </figure>
</div>
<section class="section">
  <div class="wrap">
    <p class="eyebrow">Project notes</p>
    <h2>Meet {agent.name}.</h2>
    <AgentPortrait />
    <p>{agent.bio}</p>
    <a class="button" href={designHref('/contact/', previewBase)}>
      Discuss your plans ↗
    </a>
  </div>
</section>

<style>
  .blueprint {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 6%;
  }
  .blueprint-step {
    min-height: 66svh;
    display: grid;
    align-content: center;
    justify-items: start;
    padding-block: 36px;
    border-bottom: 1px solid var(--line);
  }
  .blueprint-step a {
    min-height: 44px;
    align-content: center;
  }
  .blueprint-drawing {
    position: sticky;
    top: 8svh;
    align-self: start;
    z-index: 1;
  }
  @media (max-width: 760px) {
    .blueprint {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .blueprint-drawing {
      grid-row: 1;
      top: 0;
    }
    .blueprint-drawing :global(svg) {
      height: min(30svh, 230px);
    }
    .blueprint-step {
      min-height: 56svh;
      scroll-margin-top: 37svh;
    }
  }
  @media (max-height: 540px) {
    .blueprint-drawing {
      position: static;
    }
  }
  figure {
    margin: 0;
    padding: 16px;
    border: 1px solid var(--accent);
    background:
      linear-gradient(#17645118 1px, transparent 1px),
      linear-gradient(90deg, #17645118 1px, transparent 1px);
    background-size: 24px 24px;
    background-color: var(--paper);
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    border-top: 1px solid var(--accent);
    padding-top: 12px;
    font:
      0.75rem ui-monospace,
      monospace;
  }
  figure :global(svg) {
    display: block;
    width: 100%;
  }
  figure :global(.ln) {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  figure :global(.roof) {
    stroke-width: 6;
  }
  figure :global(.bp-door) {
    fill: var(--paper);
  }
  figure :global(.bp-window) {
    fill: #d7e8de;
  }
  figure :global(.bp-doorway) {
    fill: #f6c67a;
  }
  figure :global([data-bp='door']) {
    transform-origin: 272px 437px;
  }
  figure :global([data-bp='walk']),
  figure :global([data-bp='sign']) {
    opacity: 0;
  }
  figure :global([data-bp='sign']) {
    transform: translateY(22px);
  }
  figure :global(.bp-sign-board) {
    fill: var(--accent);
  }
  figure :global(.bp-sign-label) {
    fill: white;
    font:
      bold 15px ui-monospace,
      monospace;
  }
  [data-active='buy'] figure :global(.bp-window) {
    fill: #f6c67a;
  }
  [data-active='buy'] figure :global([data-bp='door']) {
    transform: scaleX(0.22) skewY(-8deg);
  }
  [data-active='buy'] figure :global([data-bp='walk']),
  [data-active='sell'] figure :global([data-bp='sign']) {
    opacity: 1;
  }
  [data-active='sell'] figure :global([data-bp='sign']) {
    transform: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    figure :global(.ln) {
      animation: draw 1.4s ease-out both;
    }
    figure :global(.bp-window),
    figure :global([data-bp='door']),
    figure :global([data-bp='walk']),
    figure :global([data-bp='sign']) {
      transition:
        fill 450ms ease,
        transform 450ms ease,
        opacity 450ms ease;
    }
  }
  @keyframes draw {
    from {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }
    to {
      stroke-dasharray: 1;
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  const blueprint = document.querySelector<HTMLElement>('[data-blueprint]');
  if (blueprint) {
    const steps = [...blueprint.querySelectorAll<HTMLElement>('[data-plan]')];
    const compact = matchMedia('(max-width: 760px)');
    let frame = 0;

    const update = () => {
      frame = 0;
      const readingLine = innerHeight * (compact.matches ? 0.68 : 0.5);
      const step = steps.findLast(
        (step) => step.getBoundingClientRect().top <= readingLine,
      );
      blueprint.dataset.active = step?.dataset.plan ?? 'intro';
    };
    const queue = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
    update();
  }
</script>
