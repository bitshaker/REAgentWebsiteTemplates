---
import HomeAgent from '../../src/components/HomeAgent.astro';
import { agent, phoneHref } from '../../src/lib/agent';
import { designHref } from '../../src/lib/design-pages';
import CinematicMedia from '../../src/components/CinematicMedia.astro';
import hero from './media/hero.jpg?url';
import detail1 from './media/detail-1.jpg?url';
import detail2 from './media/detail-2.jpg?url';
import detail3 from './media/detail-3.jpg?url';
import detail4 from './media/detail-4.jpg?url';
import film from './media/film.mp4?url';
import poster from './media/poster.jpg?url';
interface Props {
  previewBase?: string;
}
const { previewBase = '' } = Astro.props;
---

<div class="neighborly-home collection-home">
  <section class="n-hero">
    <div class="n-hero-copy">
      <p class="n-kicker">A good place to start</p>
      <h1>
        Let’s find
        <br />
        your <em>place.</em>
      </h1>
      <p>
        Buying your first home, making a change, or thinking about selling?
        Bring your questions about the next step.
      </p>
      <a class="n-button" href={phoneHref}>
        Call with your first question <span>↗</span>
      </a>
    </div>
    <div class="n-hero-media">
      <CinematicMedia src={film} poster={poster} />
      <span class="n-stamp">
        HERE’S TO
        <br />
        HOME ✳
      </span>
    </div>
    <div class="n-hero-footer">
      <span>Buying &amp; selling / {agent.market}</span>
      <span>Scroll for the good stuff ↓</span>
    </div>
  </section>
  <HomeAgent
    {previewBase}
    design="neighborly"
    invitation="Not sure where to start? Ask about the buying or selling process, the areas you’re considering, or what to prepare first."
    callLabel="Call and ask away"
  />
  <section class="n-intro n-wrap" data-reveal>
    <p class="n-kicker">Hey, neighbor ✳</p>
    <h2>
      Home is a feeling.
      <br />
      <em>Let’s find yours.</em>
    </h2>
    <div class="n-intro-row">
      <img src={hero} alt="" loading="lazy" />
      <p>
        “Where do I begin?” is a useful first question. So is “What should I do
        before I sell?” You don’t need a finished plan to ask about your next
        step.
      </p>
      <a
        class="n-round"
        href={designHref('/about/', previewBase)}
        aria-label={`Meet ${agent.name}`}
      >
        Meet
        <br />
        your agent ↗
      </a>
    </div>
  </section>
  <section class="n-paths">
    <div class="n-wrap">
      <div class="n-paths-heading">
        <p class="n-kicker">Your move, your way</p>
        <h2>
          What’s next
          <br />
          <em>for you?</em>
        </h2>
      </div>
      <div class="n-cards">
        <a
          href={designHref('/buyers/', previewBase)}
          class="n-card"
          data-reveal
        >
          <img src={detail1} alt="" loading="lazy" />
          <div>
            <span>01 / BUYING</span>
            <h3>
              Find a place
              <br />
              to land.
            </h3>
            <b>↗</b>
          </div>
        </a>
        <a
          href={designHref('/sellers/', previewBase)}
          class="n-card"
          data-reveal
        >
          <img src={detail2} alt="" loading="lazy" />
          <div>
            <span>02 / SELLING</span>
            <h3>
              Make room
              <br />
              for what’s next.
            </h3>
            <b>↗</b>
          </div>
        </a>
      </div>
    </div>
  </section>
  <section class="n-notes n-wrap">
    <div class="n-collage" data-reveal>
      <img src={detail3} alt="" loading="lazy" />
      <img src={detail4} alt="" loading="lazy" />
      <span>
        GOOD
        <br />
        TO KNOW ✳
      </span>
    </div>
    <div data-reveal>
      <p class="n-kicker">A few good questions</p>
      <h2>
        Wondering
        <br />
        <em>where to start?</em>
      </h2>
      <p>
        What comes before a home tour? What should you gather before listing?
        Explore the guides, then call with the part you want to talk through.
      </p>
      <div class="n-questions">
        <details>
          <summary>What helps before a first tour?</summary>
          <p>
            A few must-haves, the areas you’re considering, and questions about
            the search process.
          </p>
        </details>
        <details>
          <summary>Should I start getting my home ready?</summary>
          <p>
            Write down your possible move dates and the prep tasks you’re unsure
            about. Ask what to consider before taking on a project.
          </p>
        </details>
      </div>
      <a
        class="n-button n-button-dark"
        href={designHref('/blog/', previewBase)}
      >
        Visit the journal <span>↗</span>
      </a>
    </div>
  </section>
  <section class="n-contact">
    <p class="n-kicker">The door is open</p>
    <h2>
      Let’s make
      <br />
      <em>your move.</em>
    </h2>
    <p class="n-call-note">One question is enough to begin. What’s yours?</p>
    <a href={phoneHref}>
      Call {agent.name} · {agent.phone} ↗
    </a>
    <span>✳</span>
  </section>
</div>
