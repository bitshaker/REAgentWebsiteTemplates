---
import { optimizedArt } from '../../src/lib/media';
import HomeAgent from '../../src/components/HomeAgent.astro';
import { agent, phoneHref } from '../../src/lib/agent';
import { designHref } from '../../src/lib/design-pages';
import CinematicMedia from '../../src/components/CinematicMedia.astro';
import heroSource from './media/hero.jpg';
import detail1Source from './media/detail-1.jpg';
import detail2Source from './media/detail-2.jpg';
import detail3Source from './media/detail-3.jpg';
import detail4Source from './media/detail-4.jpg';
import film from './media/film.mp4?url';
import posterSource from './media/poster.jpg';
const hero = await optimizedArt(heroSource, '');
const detail1 = await optimizedArt(detail1Source, '');
const detail2 = await optimizedArt(detail2Source, '');
const detail3 = await optimizedArt(detail3Source, '');
const detail4 = await optimizedArt(detail4Source, '');
const poster = await optimizedArt(posterSource, '', false);
interface Props {
  previewBase?: string;
}
const { previewBase = '' } = Astro.props;
const surname = agent.name.trim().split(/\s+/).at(-1) || agent.name;
const wordmarkSize = Math.min(21.5, 125 / Math.max(surname.length, 1));
---

<div class="forma-home collection-home">
  <section class="forma-hero" aria-labelledby="forma-title">
    <img
      decoding="async"
      loading="eager"
      width={hero.width}
      height={hero.height}
      fetchpriority="high"
      src={hero.src}
      srcset={hero.srcset}
      sizes="100vw"
      alt=""
      class="forma-hero-image"
    />
    <div class="forma-hero-shade"></div>
    <div class="forma-hero-top">
      <span>Buying &amp; selling</span>
      <span>{agent.market}</span>
    </div>
    <div class="forma-hero-bottom">
      <p>
        Buying or selling?
        <br />
        Start with your next decision.
      </p>
      <a href={phoneHref}>
        Call to plan your move <span>↗</span>
      </a>
    </div>
    <h1 id="forma-title" style={`--wordmark-size: ${wordmarkSize}vw`}>
      {surname}
      <span>.</span>
      <span class="sr-only">
        {' '}
        {agent.role} in {agent.market}
      </span>
    </h1>
  </section>
  <HomeAgent
    {previewBase}
    design="forma"
    invitation="What needs to happen before you move? Call with your timing, your priorities, and the decision you’re weighing up."
    callLabel="Talk through your next step"
  />
  <section id="forma-intro" class="forma-intro f-wrap" data-reveal>
    <p class="f-label">01 / A sense of place</p>
    <div>
      <h2>
        Good spaces.
        <br />
        <em>Good moves.</em>
      </h2>
      <div class="forma-intro-end">
        <p>
          Buying: which spaces and features matter most? Selling: what needs
          attention before you list? Bring those questions to a conversation
          with {agent.name} about your move in {agent.market}.
        </p>
        <a class="f-link" href={designHref('/about/', previewBase)}>
          Meet {agent.name} <span>↗</span>
        </a>
      </div>
    </div>
  </section>
  <section class="forma-study f-wrap" aria-label="Ways to work together">
    <div class="forma-study-head">
      <p class="f-label">02 / The next chapter</p>
      <p>
        Consider every
        <br />
        possibility.
      </p>
    </div>
    <div class="forma-grid">
      <a
        class="forma-tile forma-tile-large"
        href={designHref('/buyers/', previewBase)}
        data-reveal
      >
        <img
          decoding="async"
          width={detail1.width}
          height={detail1.height}
          src={detail1.src}
          srcset={detail1.srcset}
          sizes="100vw"
          alt=""
          loading="lazy"
        />
        <span>
          <small>01 / Buying</small>
          <strong>Define your search</strong>
          <b>↗</b>
        </span>
      </a>
      <a
        class="forma-tile forma-tile-small"
        href={designHref('/sellers/', previewBase)}
        data-reveal
      >
        <img
          decoding="async"
          width={detail2.width}
          height={detail2.height}
          src={detail2.src}
          srcset={detail2.srcset}
          sizes="100vw"
          alt=""
          loading="lazy"
        />
        <span>
          <small>02 / Selling</small>
          <strong>Prioritize your preparation</strong>
          <b>↗</b>
        </span>
      </a>
    </div>
  </section>
  <section class="forma-film" aria-label="A moment at home">
    <CinematicMedia src={film} poster={poster.src} />
    <div class="forma-film-copy">
      <p class="f-label">A closer look</p>
      <h2>
        Space to
        <br />
        <em>live well.</em>
      </h2>
    </div>
  </section>
  <section class="forma-journal f-wrap" data-reveal>
    <div>
      <p class="f-label">03 / Notes &amp; ideas</p>
      <h2>
        A little
        <br />
        <em>perspective.</em>
      </h2>
      <p>
        Useful ideas for the decisions, details, and discoveries along the way.
      </p>
      <a class="f-link" href={designHref('/blog/', previewBase)}>
        Read the journal <span>↗</span>
      </a>
    </div>
    <div class="forma-journal-gallery" data-gallery>
      <img
        decoding="async"
        width={detail3.width}
        height={detail3.height}
        class="forma-gallery-main"
        src={detail3.src}
        srcset={detail3.srcset}
        sizes="100vw"
        alt="A contemporary living room with mountain views"
        loading="lazy"
      />
      <div
        class="forma-gallery-controls"
        role="group"
        hidden
        aria-label="Choose an image"
      >
        <button
          type="button"
          data-image={detail3.src}
          data-srcset={detail3.srcset}
          data-alt="A contemporary living room with mountain views"
          aria-pressed="true"
        >
          01 <span>Interior</span>
        </button>
        <button
          type="button"
          data-image={detail4.src}
          data-srcset={detail4.srcset}
          data-alt="Modern homes across a green lawn"
          aria-pressed="false"
        >
          02 <span>Exterior</span>
        </button>
      </div>
    </div>
  </section>
  <section class="forma-contact f-wrap">
    <p class="f-label">04 / Your move, on the drawing board</p>
    <h2>
      Every move starts
      <br />
      <em>somewhere.</em>
    </h2>
    <div class="forma-call-brief">
      <p>
        <span>01 / Where</span> The areas you’re considering
      </p>
      <p>
        <span>02 / When</span> The dates that shape your move
      </p>
      <p>
        <span>03 / What</span> The question holding you up
      </p>
    </div>
    <a href={phoneHref}>
      Call {agent.phone} — talk through the plan <span>↗</span>
    </a>
  </section>
</div>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-gallery]')
    .forEach((gallery) => {
      const image = gallery.querySelector<HTMLImageElement>(
        '.forma-gallery-main',
      );
      const buttons =
        gallery.querySelectorAll<HTMLButtonElement>('button[data-image]');
      const controls = gallery.querySelector<HTMLElement>(
        '.forma-gallery-controls',
      );
      if (controls) controls.hidden = false;
      buttons.forEach((button) =>
        button.addEventListener('click', () => {
          if (!image || !button.dataset.image) return;
          image.src = button.dataset.image;
          image.srcset = button.dataset.srcset || '';
          image.alt = button.dataset.alt || '';
          buttons.forEach((item) =>
            item.setAttribute('aria-pressed', String(item === button)),
          );
        }),
      );
    });
</script>
