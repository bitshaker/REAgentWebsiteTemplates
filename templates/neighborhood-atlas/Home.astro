---
import { designHref } from '../../src/lib/design-pages';
import { agent } from '../../src/lib/agent';
import AgentInvitation from '../../src/components/AgentInvitation.astro';
const positions = [
  [23, 36],
  [62, 28],
  [68, 72],
  [32, 71],
  [48, 44],
  [83, 48],
];
const areas = agent.serviceAreas.map((name, i) => ({
  name,
  point: positions[i % positions.length],
  motif: i % 3,
}));
interface Props {
  previewBase?: string;
}
const { previewBase = '' } = Astro.props;
---

<section class="atlas wrap">
  <div class="mast">
    <div>
      <p class="eyebrow">A field guide by {agent.name}</p>
      <h1>
        Get to know
        <br /> <em>the place.</em>
      </h1>
    </div>
    <p>
      Start with the places you’re curious about. Bring your questions about
      homes, routes, or the details that matter to you.
    </p>
  </div>
  <div class="atlas-body">
    <figure class="map scroll-art">
      <svg viewBox="0 0 720 535" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <pattern
            id="atlas-grid"
            width="33"
            height="33"
            patternUnits="userSpaceOnUse"
          >
            <path
              d="M0 0H33V33"
              fill="none"
              stroke="currentColor"
              stroke-opacity=".23"
              stroke-width="1.3"
            />
          </pattern>
        </defs>
        <rect width="720" height="535" fill="url(#atlas-grid)" />
        <path
          class="district"
          d="M0 0H315L290 139 172 262 0 202Z M338 0H720V210L562 246 399 180 310 147Z M0 239L172 292 315 483 254 535H0Z M720 257V535H349L320 458 432 301 554 267Z"
        />
        <path
          class="water"
          d="M277-25C335 122 92 216 249 340S467 467 361 560M277-25"
        />
        <path
          class="road"
          d="M-30 451L208 353 397 204 739 80M-30 108L193 158 385 250 750 396M125-10L157 161 177 346 148 560M533-10L511 153 531 290 611 548"
        />
        <path
          class="route"
          d="M94 387Q155 328 214 314T374 263 547 166 632 142"
        />
        <circle cx="94" cy="387" r="5" fill="currentColor" />
        <circle cx="632" cy="142" r="5" fill="currentColor" />
      </svg>
      <span class="north" aria-hidden="true">
        N<br />↑
      </span>
      {areas.slice(0, positions.length).map(({ point }, i) => (
        <label
          for={`atlas-area-${i}`}
          class="marker"
          aria-hidden="true"
          data-marker={i}
          style={`--x:${point[0]}%;--y:${point[1]}%`}
        >
          {i + 1}
        </label>
      ))}
      <figcaption class="eyebrow">
        01 / Service areas <span>Schematic · Not to scale</span>
      </figcaption>
    </figure>
    <div class="guide">
      <p class="eyebrow">The index / {agent.market}</p>
      {areas.length > 0 && (
        <fieldset>
          <legend>Choose an area to explore</legend>

          {areas.map(({ name, motif }, i) => (
            <Fragment>
              <label>
                <input
                  type="radio"
                  name="atlas-area"
                  id={`atlas-area-${i}`}
                  checked={i === 0}
                />
                <span>{String(i + 1).padStart(2, '0')}</span>
                {name}
              </label>
              <article class="area">
                <svg viewBox="0 0 300 110" class="postcard" aria-hidden="true">
                  <circle
                    cx={motif === 1 ? 226 : 65}
                    cy="35"
                    r="22"
                    fill="var(--signal)"
                  />
                  {motif === 0 && (
                    <path d="M14 98h273M42 98V57l42-32 42 32v41m-65 0V73h24v25m41-40 43-29 44 29v40m-61-19h25m36-15 28-19 34 19v34" />
                  )}
                  {motif === 1 && (
                    <path d="M18 99h264M31 99V50h67v49m-74-50 11-20h57l13 20zm90 50V36h64v63m-48-40h12m11 0h12m31 40V58h69v41m-57-24h45" />
                  )}
                  {motif === 2 && (
                    <path d="M14 99h271M28 98q54-27 108-7t121-12M56 91V61m-26 8 26-46 26 46zm148 20V51m-26 13 26-47 26 47zm49 22 28-35 27 35" />
                  )}
                </svg>
                <h2>{name}</h2>
                <p>
                  {
                    [
                      'What would you want to see on a first tour? Let’s map a visit around your priorities.',
                      'Have questions about a street, a route, or a specific home? Bring them to a local conversation.',
                      'Thinking of selling here? Let’s talk about the details a buyer should understand about your home and its setting.',
                    ][motif]
                  }
                </p>
              </article>
            </Fragment>
          ))}
        </fieldset>
      )}
      <a href={designHref('/contact/', previewBase)} class="button">
        Ask a local question ↗
      </a>
    </div>
  </div>
</section>
<AgentInvitation {previewBase} />

<script>
  // Highlight the matching marker without making the illustration a second tab stop.
  for (const atlas of document.querySelectorAll('.atlas')) {
    const sync = () => {
      const inputs = [
        ...atlas.querySelectorAll<HTMLInputElement>('input[type=radio]'),
      ];
      const selected = inputs.findIndex((input) => input.checked);
      for (const marker of atlas.querySelectorAll<HTMLElement>(
        '[data-marker]',
      )) {
        marker.classList.toggle(
          'active',
          Number(marker.dataset.marker) === selected,
        );
      }
    };
    atlas.addEventListener('change', sync);
    sync();
  }
</script>

<style>
  .atlas {
    padding-block: clamp(30px, 5vw, 76px);
  }
  .mast {
    display: grid;
    grid-template-columns: 1fr 0.42fr;
    align-items: end;
    gap: 24px;
    margin-bottom: 34px;
  }
  .mast > p {
    max-width: 32ch;
  }
  h1 {
    font-weight: 850;
    line-height: 0.95;
    margin-bottom: 0;
  }
  em {
    font-family: Georgia, serif;
    font-weight: 400;
    color: var(--accent);
  }
  .atlas-body {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    border: 1px solid var(--accent);
  }
  .map {
    margin: 0;
    min-height: 370px;
    position: relative;
    color: var(--accent);
    background: var(--wash);
    overflow: hidden;
  }
  .map svg {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
  }
  .district {
    fill: var(--paper);
    opacity: 0.64;
  }
  .water {
    stroke: var(--accent);
    stroke-opacity: 0.22;
    stroke-width: 28;
    fill: none;
  }
  .road {
    stroke: var(--paper);
    stroke-width: 8;
    fill: none;
  }
  .route {
    stroke: currentColor;
    stroke-dasharray: 5 7;
    stroke-width: 2;
    fill: none;
  }
  .north {
    position: absolute;
    inset: 18px 18px auto auto;
    text-align: center;
    line-height: 1.2;
    font-weight: 800;
  }
  .marker {
    display: grid;
    place-items: center;
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--paper);
    border: 2px solid var(--paper);
    font-weight: 750;
    cursor: pointer;
    transition: scale 0.25s;
  }
  .marker.active {
    color: var(--ink);
    background: var(--signal);
    scale: 1.12;
    z-index: 1;
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    position: absolute;
    bottom: 0;
    width: 100%;
    padding: 10px;
    background: var(--paper);
    font-size: 0.6rem;
    letter-spacing: 0.11em;
  }
  .guide {
    padding: clamp(16px, 3vw, 40px);
    min-width: 0;
  }
  fieldset {
    padding: 0;
    margin: 0 0 16px;
    border: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  legend {
    font-weight: 700;
    margin-bottom: 5px;
  }
  .guide label {
    display: flex;
    align-items: center;
    min-height: 44px;
    gap: 10px;
    border-bottom: 1px solid var(--line);
    padding: 5px 8px;
    cursor: pointer;
  }
  .guide label:has(:checked) {
    background: var(--wash);
    color: var(--accent);
  }
  .guide label:has(:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: -3px;
  }
  .guide label span {
    font-size: 0.7em;
  }
  input {
    accent-color: var(--accent);
  }
  .area {
    order: 1;
    display: none;
    margin: 16px 0 0;
  }
  fieldset > label:has(:checked) + .area {
    display: block;
  }
  .area h2 {
    font-size: clamp(1.4rem, 3vw, 2.25rem);
    margin-bottom: 8px;
    overflow-wrap: anywhere;
  }
  .area p {
    margin-bottom: 0;
  }
  .postcard {
    width: 100%;
    height: 90px;
    margin-bottom: 9px;
    background: var(--wash);
    color: var(--accent);
  }
  .postcard path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }
  @media (max-width: 760px) {
    .mast,
    .atlas-body {
      grid-template-columns: 1fr;
    }
    .mast {
      gap: 16px;
      margin-bottom: 16px;
    }
    .mast > p {
      margin: 0;
    }
    .map {
      min-height: clamp(250px, 72vw, 410px);
      border-bottom: 1px solid var(--accent);
    }
  }
</style>
