---
import { sitePath } from '../../src/lib/site';
import AgentPortrait from '../../src/components/AgentPortrait.astro';
import { agent } from '../../src/lib/agent';
import { designHref } from '../../src/lib/design-pages';
import Services from '../../src/components/Services.astro';
interface Props {
  previewBase?: string;
}
const { previewBase = '' } = Astro.props;
---

<section class="editorial-hero wrap">
  <p class="eyebrow">The art of moving well · {agent.market}</p>
  <div class="editorial-heading">
    <h1>
      Good places.
      <br />
      New beginnings.
    </h1>
    <p class="eyebrow">
      Real estate,
      <br />
      with perspective.
    </p>
  </div>
  <div class="editorial-image scroll-art">
    <img
      class="hero-art"
      src={sitePath('/images/architecture.svg')}
      alt="Architectural illustration of a garden courtyard and contemporary home"
      width="900"
      height="1000"
      fetchpriority="high"
    />
  </div>
  <div class="editorial-caption">
    <span>
      {agent.name} / {agent.role}
    </span>
    <a href={designHref('/contact/', previewBase)}>Begin a conversation ↗</a>
  </div>
</section>
<section class="section editorial-story">
  <div class="wrap split">
    <h2>
      Your next chapter,
      <br />
      considered carefully.
    </h2>
    <div>
      <AgentPortrait />
      <p>{agent.bio}</p>
      <a href={designHref('/about/', previewBase)}>Meet your agent ↗</a>
    </div>
  </div>
</section>
<Services {previewBase} />
