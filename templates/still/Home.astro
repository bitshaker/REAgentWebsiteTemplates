---
import { optimizedArt } from '../../src/lib/media';
import HomeAgent from '../../src/components/HomeAgent.astro';
import { agent, phoneHref } from '../../src/lib/agent';
import { designHref } from '../../src/lib/design-pages';
import CinematicMedia from '../../src/components/CinematicMedia.astro';
import heroSource from './media/hero.jpg';
import detail1Source from './media/detail-1.jpg';
import detail2Source from './media/detail-2.jpg';
import detail3Source from './media/detail-3.jpg';
import detail4Source from './media/detail-4.jpg';
import posterSource from './media/poster.jpg';
import film from './media/film.mp4?url';
const hero = await optimizedArt(heroSource, '');
const detail1 = await optimizedArt(detail1Source, '');
const detail2 = await optimizedArt(detail2Source, '');
const detail3 = await optimizedArt(detail3Source, '');
const detail4 = await optimizedArt(detail4Source, '');
const poster = await optimizedArt(posterSource, '', false);
interface Props {
  previewBase?: string;
}
const { previewBase = '' } = Astro.props;
const href = (path: string) => designHref(path, previewBase);
const scenes = [detail1, detail2, detail3, detail4];
const prompts = [
  'How would an ordinary day work here?',
  'What belongs on your must-have list?',
  'What would you want to inspect?',
  'What would make a move worthwhile?',
];
---

<div class="still-home collection-home">
  <section class="still-hero">
    <img
      decoding="async"
      loading="eager"
      width={hero.width}
      height={hero.height}
      src={hero.src}
      srcset={hero.srcset}
      sizes="100vw"
      alt=""
      class="still-hero-image"
      fetchpriority="high"
    />
    <div class="still-hero-shade"></div>
    <div class="still-hero-copy" data-reveal>
      <h1>
        Room to
        <br />
        <em>be yourself.</em>
      </h1>
      <div class="still-hero-bottom">
        <div>
          <p>
            Buying or selling in {agent.market}? Start with what matters to you.
          </p>
          <a class="still-text-link" href={phoneHref}>
            Call to talk it through ↗
          </a>
        </div>
        <a
          class="still-circle"
          href="#still-intro"
          aria-label="Explore the introduction"
        >
          ↓
        </a>
      </div>
    </div>
    <span class="still-vertical">A study in living · 01</span>
  </section>
  <HomeAgent
    {previewBase}
    design="still"
    invitation="If the next step feels unclear, bring one question: what should you consider before you search, list, or choose a date?"
    callLabel="Call about what matters to you"
  />
  <section id="still-intro" class="still-intro" data-reveal>
    <p class="still-label">01 / A little perspective</p>
    <div>
      <h2>
        A home is more than
        <br />
        <em>an address.</em>
      </h2>
      <p>
        It’s how an ordinary day works. Before a search, name the things your
        next home needs to do better. Before a sale, name the dates and
        decisions that matter. Those details give a conversation a place to
        begin.
      </p>
      <a class="still-text-link" href={href('/about/')}>
        Meet {agent.name} <span>↗</span>
      </a>
    </div>
  </section>
  <section class="still-gallery" aria-labelledby="still-gallery-title">
    <div class="still-gallery-head" data-reveal>
      <div>
        <p class="still-label">02 / Questions worth a closer look</p>
        <h2 id="still-gallery-title">
          The beauty of
          <br />
          <em>looking closer.</em>
        </h2>
      </div>
      <p>
        Use these illustrative scenes to think about your own priorities. Which
        details would you want to discuss before a move?
      </p>
    </div>
    <div
      class="still-track"
      role="region"
      tabindex="0"
      aria-label="Editorial image gallery"
    >
      {scenes.map((scene, i) => (
        <figure>
          <img
            decoding="async"
            width={scene.width}
            height={scene.height}
            src={scene.src}
            srcset={scene.srcset}
            sizes="100vw"
            alt=""
            loading="lazy"
          />
          <figcaption>
            <span>
              0{i + 1} / {prompts[i]}
            </span>
            <span>Illustrative scene</span>
          </figcaption>
        </figure>
      ))}
    </div>
    <div
      class="still-gallery-controls"
      role="group"
      aria-label="Gallery controls"
      hidden
    >
      <span data-gallery-count aria-live="polite">
        Photography / 01 of 04
      </span>
      <div>
        <button type="button" data-still-prev aria-label="Previous image">
          ←
        </button>
        <button type="button" data-still-next aria-label="Next image">
          →
        </button>
      </div>
    </div>
  </section>
  <section class="still-story" data-reveal>
    <div class="still-story-image">
      <img
        decoding="async"
        width={detail2.width}
        height={detail2.height}
        src={detail2.src}
        srcset={detail2.srcset}
        sizes="100vw"
        alt=""
        loading="lazy"
        data-parallax
      />
    </div>
    <div class="still-story-copy">
      <p class="still-label">03 / The way forward</p>
      <h2>
        Good decisions
        <br />
        <em>start with care.</em>
      </h2>
      <p>
        You may be weighing two homes, a possible list date, or whether to move
        at all. Call {agent.name} to discuss the tradeoffs and the questions you
        still need answered.
      </p>
      <div class="still-paths">
        <a href={href('/buyers/')}>
          <span>01</span> Buying <span>↗</span>
        </a>
        <a href={href('/sellers/')}>
          <span>02</span> Selling <span>↗</span>
        </a>
      </div>
    </div>
  </section>
  <section class="still-film" aria-label="A study in living">
    <CinematicMedia src={film} poster={poster.src} />
    <div class="still-film-copy">
      <p class="still-label">04 / In the moment</p>
      <h2>
        Take your time.
        <br />
        <em>Find your place.</em>
      </h2>
      <span>Illustrative film</span>
    </div>
  </section>
  <section class="still-end" data-reveal>
    <p class="still-label">A note from {agent.name}</p>
    <h2>
      Let’s make your
      <br />
      <em>next move meaningful.</em>
    </h2>
    <p class="still-call-note">
      You can begin with an open question, even while your plans are taking
      shape.
    </p>
    <a class="still-text-link" href={phoneHref}>
      Call {agent.phone} · find a starting point <span>↗</span>
    </a>
  </section>
</div>
<script>
  document.querySelectorAll('.still-gallery').forEach((gallery) => {
    const controls = gallery.querySelector<HTMLElement>(
      '.still-gallery-controls',
    );
    if (controls) controls.hidden = false;
    const track = gallery.querySelector('.still-track');
    const scroll = (direction: number) => {
      if (!track) return;
      const behavior = matchMedia('(prefers-reduced-motion: reduce)').matches
        ? 'auto'
        : 'smooth';
      track.scrollBy({ left: direction * track.clientWidth * 0.7, behavior });
    };
    gallery
      .querySelector('[data-still-prev]')
      ?.addEventListener('click', () => scroll(-1));
    gallery
      .querySelector('[data-still-next]')
      ?.addEventListener('click', () => scroll(1));
    track?.addEventListener(
      'scroll',
      () => {
        const figures = Array.from(track.querySelectorAll('figure'));
        const first = figures[0];
        if (!first) return;
        const position =
          track.getBoundingClientRect().left +
          (first.getBoundingClientRect().left -
            track.getBoundingClientRect().left +
            track.scrollLeft);
        const index = figures.reduce(
          (closest, figure, i) =>
            Math.abs(figure.getBoundingClientRect().left - position) <
            Math.abs(figures[closest].getBoundingClientRect().left - position)
              ? i
              : closest,
          0,
        );
        const count = gallery.querySelector('[data-gallery-count]');
        if (count)
          count.textContent = `Photography / ${String(index + 1).padStart(2, '0')} of 04`;
      },
      { passive: true },
    );
  });
</script>
