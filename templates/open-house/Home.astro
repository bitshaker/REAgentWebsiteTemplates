---
import { agent } from '../../src/lib/agent';
import { designHref } from '../../src/lib/design-pages';
import AgentInvitation from '../../src/components/AgentInvitation.astro';
const rooms = [
  {
    id: 'entry',
    x: 49,
    name: 'Entry',
    title: 'Come on in.',
    text: `I’m ${agent.name}. Tell me what you’re working toward, and we’ll figure out where to begin.`,
    label: 'Meet your agent',
    href: '/about/',
  },
  {
    id: 'living',
    x: 71,
    name: 'Living room',
    title: 'Tour with a plan.',
    text: 'Look past the staging. Notice how the rooms connect, where the light falls, and what you might want to inspect more closely.',
    label: 'Read the buyer guide',
    href: '/buyers/',
  },
  {
    id: 'kitchen',
    x: 27,
    name: 'Kitchen',
    title: 'Prepare with purpose.',
    text: 'On a first walkthrough we can talk through which small changes might help buyers see the space clearly, and where to save your effort.',
    label: 'Read the seller guide',
    href: '/sellers/',
  },
];
interface Props {
  previewBase?: string;
}
const { previewBase = '' } = Astro.props;
---

<section class="house wrap">
  <div class="title">
    <p class="eyebrow">An open invitation from {agent.name}</p>
    <h1>
      Make yourself <em>at home.</em>
    </h1>
    <p>Pick a room to see how we can work together.</p>
  </div>
  <div class="house-layout">
    <figure class="cutaway">
      <div class="model scroll-art">
        <svg viewBox="0 0 620 490" aria-hidden="true">
          <defs>
            <pattern
              id="house-grid"
              width="22"
              height="22"
              patternUnits="userSpaceOnUse"
            >
              <path
                d="M22 0H0v22"
                fill="none"
                stroke="currentColor"
                stroke-opacity=".16"
              />
            </pattern>
          </defs>
          <rect width="620" height="490" fill="url(#house-grid)" />
          <ellipse
            cx="316"
            cy="425"
            rx="260"
            ry="28"
            fill="var(--ink)"
            opacity=".14"
          />
          <g stroke="var(--ink)" stroke-width="3" stroke-linejoin="round">
            <path
              fill="var(--accent)"
              d="M50 213 296 46 569 203 538 223 294 91 80 233Z"
            />
            <path fill="var(--paper)" d="M81 215 296 68 540 207v199H81Z" />
            <path fill="var(--signal)" d="m296 82 74 49H222Z" />
            <path fill="var(--wash)" d="M83 407h457l27 19H57Z" />
            <g class="room kitchen">
              <path class="wall" d="M103 219h137v166H103Z" />
              <path
                fill="var(--wash)"
                d="M111 307h112v67H111Zm0 17h112m-75 0v50m39-50v50"
              />
              <path fill="var(--paper)" d="M103 301h126v9H103Z" />
              <path
                fill="var(--paper)"
                d="M123 240h70v40h-70Zm35 0v40m-35-20h70"
              />
              <path fill="none" d="M133 302v-12q0-10 10-10t10 10" />
            </g>
            <g class="room entry">
              <path class="wall" d="M247 219h109v166H247Z" />
              <path
                fill="var(--accent)"
                d="M266 371V284a36 36 0 0 1 72 0v87Z"
              />
              <path
                fill="none"
                stroke="var(--paper)"
                d="M277 360v-76a25 25 0 0 1 50 0v76Z"
              />
              <circle cx="320" cy="324" r="4" fill="var(--signal)" />
              <path fill="var(--paper)" d="M258 371h89v10h-89Z" />
            </g>
            <g class="room living">
              <path class="wall" d="M363 219h155v166H363Z" />
              <path
                fill="var(--paper)"
                d="M390 236h64v54h-64Zm32 0v54m-32-27h64"
              />
              <path fill="none" d="M496 354v-70m-12 70h24" />
              <path fill="var(--accent)" d="m482 260-8 27h35l-8-27Z" />
              <path
                fill="var(--wash)"
                d="M385 355v-35q0-13 13-13h65q13 0 13 13v35Z"
              />
              <path
                fill="var(--paper)"
                d="M377 337q0-7 7-7t7 7v5h79v-5q0-7 7-7t7 7v19H377Z"
              />
              <path fill="none" d="M388 356v12m84-12v12" />
            </g>
            <path fill="var(--paper)" d="M100 204h421v15H100Z" />
          </g>
        </svg>
        {rooms.map(({ id, x }, i) => (
          <label
            class:list={['hotspot', `hotspot-${id}`]}
            for={`house-${id}`}
            aria-hidden="true"
            style={`--room-x:${x}%`}
          >
            {i + 1}
          </label>
        ))}
      </div>
      <figcaption class="eyebrow">
        Fig. 01 <span>House in section · Illustration</span>
      </figcaption>
    </figure>
    <fieldset>
      <legend>Choose a room</legend>
      {rooms.map(({ id, name, title, text, label, href }, i) => (
        <Fragment>
          <label>
            <input
              type="radio"
              name="house-room"
              id={`house-${id}`}
              value={id}
              checked={i === 0}
            />
            <span>0{i + 1}</span>
            {name}
          </label>
          <div class="room-copy">
            <h2>{title}</h2>
            <p>{text}</p>
            <a href={designHref(href, previewBase)} class="button">
              {label} ↗
            </a>
          </div>
        </Fragment>
      ))}
    </fieldset>
  </div>
</section>
<AgentInvitation {previewBase} />

<style>
  .house {
    padding-block: clamp(34px, 5vw, 76px);
  }
  .title {
    text-align: center;
  }
  .title h1 {
    font-weight: 800;
    margin-bottom: 10px;
  }
  .title em {
    font-weight: 400;
    font-family: Georgia, serif;
    color: var(--accent);
  }
  .house-layout {
    display: grid;
    grid-template-columns: 1.52fr 1fr;
    gap: clamp(16px, 3vw, 40px);
    align-items: center;
  }
  .cutaway {
    margin: 0;
    background: var(--wash);
    border: 1px solid var(--ink);
    box-shadow: 5px 5px 0 var(--ink);
  }
  .model {
    position: relative;
  }
  .hotspot {
    display: grid;
    place-items: center;
    position: absolute;
    left: var(--room-x);
    top: 76%;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    border: 2px solid var(--paper);
    font-weight: 750;
    cursor: pointer;
  }
  .house:has([value='entry']:checked) .hotspot-entry,
  .house:has([value='kitchen']:checked) .hotspot-kitchen,
  .house:has([value='living']:checked) .hotspot-living {
    background: var(--signal);
    color: var(--ink);
    border-color: var(--ink);
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .wall {
    fill: var(--paper);
    transition: fill 0.35s;
  }
  .room {
    transform-box: fill-box;
    transform-origin: center bottom;
    transition: transform 0.35s;
  }
  .house:has([value='entry']:checked) .entry,
  .house:has([value='kitchen']:checked) .kitchen,
  .house:has([value='living']:checked) .living {
    transform: translateY(-7px);
  }
  .house:has([value='entry']:checked) .entry .wall,
  .house:has([value='kitchen']:checked) .kitchen .wall,
  .house:has([value='living']:checked) .living .wall {
    fill: var(--signal);
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    padding: 10px 14px;
    border-top: 1px solid var(--ink);
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  legend {
    font-size: 0.78rem;
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: 0.16em;
    margin-bottom: 8px;
  }
  fieldset label {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 46px;
    cursor: pointer;
    border: 1px solid var(--line);
    padding: 5px 10px;
    font-weight: 700;
  }
  fieldset label span {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
  }
  input {
    accent-color: var(--ink);
  }
  fieldset label:has(:checked) {
    background: var(--signal);
    border-color: var(--ink);
  }
  fieldset label:has(:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: -3px;
  }
  .room-copy {
    order: 1;
    display: none;
    margin-top: 14px;
    padding: clamp(16px, 2.5vw, 32px);
    background: var(--wash);
  }
  label:has(:checked) + .room-copy {
    display: block;
    animation: unfold 0.3s ease-out both;
  }
  h2 {
    font-size: clamp(1.8rem, 3.6vw, 3rem);
    margin-bottom: 10px;
  }
  @keyframes unfold {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  @media (max-width: 760px) {
    .house-layout {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .title {
      text-align: left;
    }
  }
</style>
