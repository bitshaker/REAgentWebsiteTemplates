---
import HomeAgent from '../../src/components/HomeAgent.astro';
import CinematicMedia from '../../src/components/CinematicMedia.astro';
import { agent, phoneHref } from '../../src/lib/agent';
import { designHref } from '../../src/lib/design-pages';
import film from './media/film.mp4?url';
import poster from './media/poster.jpg?url';
import one from './media/detail-1.jpg?url';
import two from './media/detail-2.jpg?url';
import three from './media/detail-3.jpg?url';
import four from './media/detail-4.jpg?url';
interface Props {
  previewBase?: string;
}
const { previewBase = '' } = Astro.props;
const initials = agent.name
  .split(/\s+/)
  .filter(Boolean)
  .map((part) => part[0])
  .slice(0, 2)
  .join('');
---

<div class="monogram-home collection-home">
  <section class="m-hero" aria-labelledby="m-title">
    <div class="m-film">
      <CinematicMedia src={film} poster={poster} />
    </div>
    <span class="m-initials" aria-hidden="true">
      {initials}
    </span>
    <div class="m-hero-copy" data-reveal>
      <h1 id="m-title">
        A place for
        <br />
        <em>your story.</em>
      </h1>
      <p class="m-call-reason">
        Buying or selling in {agent.market}, with your priorities at the center.
      </p>
      <a href={phoneHref}>Call about your next move ↗</a>
    </div>
    <p class="m-hero-bottom">
      A considered way home <span>Scroll to explore ↓</span>
    </p>
  </section>
  <HomeAgent
    {previewBase}
    design="monogram"
    invitation="Choosing an agent is personal, too. Call to ask about the approach, discuss your priorities, and decide what you need from the person guiding your move."
    callLabel="Get to know your agent by phone"
  />
  <section class="m-statement" data-reveal>
    <p class="m-label">01 / Our point of view</p>
    <h2>
      Spaces shape
      <br />
      <em>how we live.</em>
    </h2>
    <div>
      <p>
        A home search or sale starts with your circumstances. What needs to
        change? What would you like to keep? Bring both to a conversation with{' '}
        {agent.name}, along with any questions about working together.
      </p>
      <ul class="m-fit-questions">
        <li>How would we communicate?</li>
        <li>What would the first steps involve?</li>
        <li>Which services fit my plans?</li>
      </ul>
      <a href={designHref('/about/', previewBase)}>
        Get to know {agent.name} ↗
      </a>
    </div>
  </section>
  <section class="m-editorial" aria-label="Perspectives on home">
    <div class="m-editorial-heading">
      <p class="m-label">02 / The everyday, elevated</p>
      <h2>
        A study in
        <br />
        <em>living well.</em>
      </h2>
    </div>
    <figure class="m-photo-one" data-reveal>
      <img src={one} alt="" loading="lazy" data-m-scene-image />
      <figcaption>Form / Light / Life</figcaption>
      <div
        class="m-scene-controls"
        data-m-scene-controls
        hidden
        aria-label="Choose a scene"
      >
        <button type="button" data-scene-src={one} aria-pressed="true">
          01 / Architecture
        </button>
        <button type="button" data-scene-src={two} aria-pressed="false">
          02 / Interiors
        </button>
      </div>
    </figure>
    <figure class="m-photo-two" data-reveal>
      <img src={two} alt="" loading="lazy" />
      <figcaption>Thoughtful spaces, lasting impressions</figcaption>
    </figure>
  </section>
  <section class="m-paths" aria-labelledby="m-paths-title">
    <p class="m-label">03 / Your next chapter</p>
    <h2 id="m-paths-title">
      Where are
      <br />
      <em>you headed?</em>
    </h2>
    <div class="m-path-grid">
      <a href={designHref('/buyers/', previewBase)}>
        <img src={three} alt="" loading="lazy" />
        <span>01 / Discover</span>
        <h3>Buying a home</h3>
        <p>
          Talk through your must-haves, the areas you’re considering, and
          questions before touring.
        </p>
        <b>Explore buying ↗</b>
      </a>
      <a href={designHref('/sellers/', previewBase)}>
        <img src={four} alt="" loading="lazy" />
        <span>02 / Begin again</span>
        <h3>Selling a home</h3>
        <p>
          Discuss your timing, preparation questions, and what matters beyond
          the asking price.
        </p>
        <b>Explore selling ↗</b>
      </a>
    </div>
  </section>
  <section class="m-contact" data-reveal>
    <p class="m-label">An invitation</p>
    <h2>
      Let’s create
      <br />
      <em>what comes next.</em>
    </h2>
    <p class="m-call-note">
      Ask about communication, the process, and how your priorities would shape
      the work.
    </p>
    <a href={phoneHref}>Call {agent.phone} · talk about working together ↗</a>
    <span aria-hidden="true">{initials}</span>
  </section>
</div>

<script>
  const sceneControls = document.querySelector<HTMLElement>(
    '[data-m-scene-controls]',
  );
  const sceneImage = document.querySelector<HTMLImageElement>(
    '[data-m-scene-image]',
  );
  if (sceneControls && sceneImage) {
    sceneControls.hidden = false;
    sceneControls
      .querySelectorAll<HTMLButtonElement>('button')
      .forEach((button) => {
        button.addEventListener('click', () => {
          if (!button.dataset.sceneSrc) return;
          sceneImage.src = button.dataset.sceneSrc;
          sceneControls
            .querySelectorAll('button')
            .forEach((item) =>
              item.setAttribute('aria-pressed', String(item === button)),
            );
        });
      });
  }
</script>
