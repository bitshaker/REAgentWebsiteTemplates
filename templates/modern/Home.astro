---
import { sitePath } from '../../src/lib/site';
import AgentPortrait from '../../src/components/AgentPortrait.astro';
import { agent } from '../../src/lib/agent';
import { designHref } from '../../src/lib/design-pages';
import Services from '../../src/components/Services.astro';
interface Props {
  previewBase?: string;
}
const { previewBase = '' } = Astro.props;
---

<section class="modern-hero">
  <div class="split">
    <div class="modern-copy">
      <p class="eyebrow">Your next move starts here.</p>
      <h1>
        Local insight.
        <br />
        <span>
          Forward
          <br />
          momentum.
        </span>
      </h1>
      <p>
        Buying or selling in {agent.market}? Get a clear plan, practical
        answers, and guidance built around you.
      </p>
      <a class="button" href={designHref('/contact/', previewBase)}>
        Make your next move ↗
      </a>
    </div>
    <div class="modern-image scroll-art">
      <img
        class="hero-art"
        src={sitePath('/images/architecture.svg')}
        alt="Illustrated modern home with garden, courtyard, and sunlit windows"
        width="900"
        height="1000"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
<section class="section modern-intro">
  <div class="wrap split">
    <div>
      <p class="eyebrow">Hello, I'm {agent.name}.</p>
      <h2>
        Clear advice.
        <br />
        Personal attention.
      </h2>
    </div>
    <div>
      <AgentPortrait />
      <p>{agent.bio}</p>
      <a href={designHref('/about/', previewBase)}>More about my approach ↗</a>
    </div>
  </div>
</section>
<Services {previewBase} />
