---
import AgentPortrait from '../../src/components/AgentPortrait.astro';
import { agent } from '../../src/lib/agent';
import { designHref } from '../../src/lib/design-pages';
import lake from './media/lake.mp4?url';
import poster from './media/lake.jpg?url';
import buyers from './media/family.webp?url';
import sellers from './media/modern-pool-day.webp?url';
import about from './media/med-villa-sunset.webp?url';
import blog from './media/modern-dusk-lit.webp?url';

import buyerInset from './media/keys.webp?url';

import sellerInset from './media/interior-warm.webp?url';

import aboutInset from './media/blueprint.webp?url';

import blogInset from './media/team.webp?url';

interface Props {
  previewBase?: string;
}
const { previewBase = '' } = Astro.props;
const chapters = [
  {
    hour: '6:42 AM',
    phase: 'Sunrise',
    title: 'A fresh start.',
    page: 'buyers',
    label: 'Explore buying',
    image: buyers,
    inset: buyerInset,
  },
  {
    hour: '12:10 PM',
    phase: 'High noon',
    title: 'Make a plan to sell.',
    page: 'sellers',
    label: 'Explore selling',
    image: sellers,
    inset: sellerInset,
  },
  {
    hour: '5:48 PM',
    phase: 'Golden hour',
    title: `Meet ${agent.name}.`,
    page: 'about',
    label: 'About your agent',
    image: about,
    inset: aboutInset,
  },
  {
    hour: '8:15 PM',
    phase: 'Twilight',
    title: 'Room to reflect.',
    page: 'blog',
    label: 'Read the journal',
    image: blog,
    inset: blogInset,
  },
];
---

<section class="film" aria-labelledby="film-title">
  <video
    data-workshop-film
    data-src={lake}
    poster={poster}
    preload="none"
    muted
    loop
    playsinline
    aria-hidden="true"
  ></video>
  <div class="film-copy wrap">
    <p class="eyebrow">
      {agent.name} / {agent.market}
    </p>
    <h1 id="film-title">
      A day to imagine
      <br />
      <em>what’s next.</em>
    </h1>
  </div>
  <div class="film-footer wrap">
    <p>Opening scene / Lake Mission Viejo, California</p>
    <button type="button" data-film-toggle hidden>
      Play background video
    </button>
  </div>
</section>
<section class="section wrap" aria-labelledby="chapters-title">
  <p class="eyebrow">From sunrise to twilight</p>
  <h2 id="chapters-title">A day in four chapters.</h2>
  <nav class="chapter-index" aria-label="Jump to a chapter">
    {chapters.map(({ phase, page }, i) => (
      <a href={`#chapter-${page}`}>
        <span aria-hidden="true">0{i + 1} / </span>
        {phase}
      </a>
    ))}
  </nav>
  <ol
    class="chapter-track"
    data-chapter-track
    aria-labelledby="chapters-title"
    tabindex="0"
    role="list"
  >
    {chapters.map(({ hour, phase, title, page, label, image, inset }) => (
      <li class="chapter" id={`chapter-${page}`}>
        <div class="chapter-art">
          <img src={image} alt="" width="768" height="512" loading="lazy" />
          <img
            class="chapter-inset"
            src={inset}
            alt=""
            width="256"
            height="192"
            loading="lazy"
          />
        </div>
        <div class="chapter-copy">
          <p class="eyebrow">
            {hour} / {phase}
          </p>
          <h3>{title}</h3>
          <a href={designHref(`/${page}/`, previewBase)}>{label} ↗</a>
        </div>
      </li>
    ))}
  </ol>
</section>
<section class="section">
  <div class="wrap">
    <AgentPortrait />
    <h2>Let’s talk about your move.</h2>
    <a class="button" href={designHref('/contact/', previewBase)}>
      Get in touch ↗
    </a>
  </div>
</section>

<style>
  .film {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: 100svh;
    color: #fff1d9;
    background: #120d09;
  }
  .film video,
  .film::before {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .film video {
    z-index: -2;
    object-fit: cover;
  }
  .film::before {
    content: '';
    z-index: -1;
    background: linear-gradient(#120d0977, #120d09a3 55%, #120d09dc);
  }
  .film-copy {
    align-self: center;
    text-align: center;
    padding-block: 52px;
  }
  h1 em {
    color: #f1b765;
  }
  .film-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    padding-block: 16px;
    font-size: 0.8rem;
  }
  .film-footer p {
    margin: 0;
  }
  .film-footer button {
    min-height: 44px;
    border: 1px solid currentColor;
    background: #120d09;
    color: inherit;
    padding-inline: 12px;
    cursor: pointer;
  }
  .chapter-index {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin-bottom: 14px;
  }
  .chapter-index a {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    min-height: 44px;
    padding: 0 10px;
    border: 1px solid var(--line);
    text-decoration: none;
  }
  .chapter-index a:hover {
    border-color: var(--accent);
  }
  .chapter-track {
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(85%, 570px);
    gap: clamp(12px, 2vw, 24px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 5px 0 15px;
    margin: 0;
    list-style: none;
    scrollbar-color: var(--accent) var(--paper);
  }
  .chapter {
    scroll-snap-align: start;
    background: #f8e0c7;
    color: #311c12;
  }
  .chapter:nth-child(2) {
    background: #fcf0d9;
  }
  .chapter:nth-child(3) {
    background: #512d26;
    color: #fff1d9;
  }
  .chapter:nth-child(4) {
    background: #261e2a;
    color: #fff1d9;
  }
  .chapter-copy {
    padding: clamp(18px, 4vw, 44px);
  }
  .chapter h3 {
    font-size: clamp(1.85rem, 4vw, 3.7rem);
  }
  .chapter :focus-visible {
    outline-color: currentColor;
  }
  .chapter-art {
    position: relative;
  }
  .chapter-art img {
    aspect-ratio: 1.65;
    width: 100%;
    height: auto;
    object-fit: cover;
  }
  .chapter-art .chapter-inset {
    position: absolute;
    right: 4%;
    bottom: 7%;
    width: 29%;
    aspect-ratio: 4 / 3;
    border: 3px solid #fff1d9;
  }
  .chapter-copy a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .chapter-track {
      scroll-behavior: smooth;
    }
  }
</style>

<script>
  const film = document.querySelector<HTMLVideoElement>('[data-workshop-film]');
  const toggle =
    document.querySelector<HTMLButtonElement>('[data-film-toggle]');
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

  if (film?.dataset.src && toggle) {
    const source = film.dataset.src;
    const play = () => {
      if (!film.src) film.src = source;
      void film.play().catch(() => {});
    };
    const updateLabel = () => {
      toggle.textContent = film.paused
        ? 'Play background video'
        : 'Pause background video';
    };
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      if (film.paused) play();
      else film.pause();
    });
    film.addEventListener('play', updateLabel);
    film.addEventListener('pause', updateLabel);
    film.addEventListener('error', () => {
      toggle.hidden = true;
    });
    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) film.pause();
    });
    if (!reducedMotion.matches) play();
  }

  const track = document.querySelector<HTMLOListElement>(
    '[data-chapter-track]',
  );
  const chapterIndex = document.querySelector<HTMLElement>('.chapter-index');
  chapterIndex?.addEventListener('click', (event) => {
    if (
      !(event.target instanceof Element) ||
      event.metaKey ||
      event.ctrlKey ||
      event.shiftKey ||
      event.altKey
    )
      return;
    const link = event.target.closest<HTMLAnchorElement>(
      'a[href^="#chapter-"]',
    );
    const chapter = link && document.getElementById(link.hash.slice(1));
    if (!track || !chapter || chapter.parentElement !== track) return;
    event.preventDefault();
    track.scrollTo({ left: chapter.offsetLeft });
  });
</script>
