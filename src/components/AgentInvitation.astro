---
import AgentPortrait from './AgentPortrait.astro';
import { agent } from '../lib/agent';
import { designHref } from '../lib/design-pages';
interface Props {
  previewBase?: string;
}
const { previewBase = '' } = Astro.props;
---

<section class="invitation section">
  <div class="wrap split">
    <div>
      <p class="eyebrow">
        {agent.name} · {agent.role}
      </p>
      <h2>Let’s talk about your move.</h2>
    </div>
    <div>
      <AgentPortrait />
      <p>{agent.bio}</p>
      <a class="button" href={designHref('/contact/', previewBase)}>
        Start a conversation ↗
      </a>
      <a class="profile" href={designHref('/about/', previewBase)}>
        Meet your agent
      </a>
    </div>
  </div>
</section>

<style>
  .invitation {
    background: var(--wash, var(--paper));
    border-block: 1px solid var(--line);
  }
  h2 {
    margin-bottom: 0;
  }
  .profile {
    display: inline-block;
    margin: 12px 0 12px 16px;
  }
</style>
