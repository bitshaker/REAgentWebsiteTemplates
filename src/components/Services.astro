---
import { agent } from '../lib/agent';
import { designHref } from '../lib/design-pages';
interface Props {
  previewBase?: string;
}
const { previewBase = '' } = Astro.props;
---

<section class="section">
  <div class="wrap">
    <p class="eyebrow">Here for your next chapter</p>
    <h2>Where would you like to begin?</h2>
    <div class="cards">
      <article class="card">
        <p class="number">01 / BUY</p>
        <h3>Find your place.</h3>
        <p>
          Define your priorities, understand the process, and move from browsing
          to a considered decision.
        </p>
        <a href={designHref('/buyers/', previewBase)}>A guide for buyers ↗</a>
      </article>
      <article class="card">
        <p class="number">02 / SELL</p>
        <h3>Make a smart move.</h3>
        <p>
          From preparation to closing, build a selling strategy around your
          property and your next chapter.
        </p>
        <a href={designHref('/sellers/', previewBase)}>A guide for sellers ↗</a>
      </article>
      <article class="card">
        <p class="number">03 / EXPLORE</p>
        <h3>A little perspective.</h3>
        <p>
          Practical ideas and useful questions for your real estate journey in{' '}
          {agent.market}.
        </p>
        <a href={designHref('/blog/', previewBase)}>Read the journal ↗</a>
      </article>
    </div>
  </div>
</section>
