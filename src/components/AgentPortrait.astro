---
import { agentPortrait } from '../lib/portrait';

interface Props {
  wide?: boolean;
}
const { wide = false } = Astro.props;
const portrait = await agentPortrait();
---

{portrait ? (
  <figure class:list={['agent-portrait', { wide }]}>
    <img
      src={portrait.src}
      srcset={portrait.srcset}
      sizes={
        wide
          ? '(min-width: 761px) 45vw, 90vw'
          : '(min-width: 601px) 280px, 180px'
      }
      alt={portrait.alt}
      width={portrait.width}
      height={portrait.height}
      loading="lazy"
      decoding="async"
    />
    {portrait.isSample && <figcaption>Sample portrait</figcaption>}
  </figure>
) : (
  <slot />
)}

<style>
  .agent-portrait {
    position: relative;
    width: min(100%, 280px);
    margin: 0 0 20px;
    border: 1px solid var(--line);
  }
  .agent-portrait img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 32%;
  }
  .wide {
    width: 100%;
    margin: 0;
  }
  .wide img {
    aspect-ratio: 1.65;
    object-position: center top;
  }
  figcaption {
    position: absolute;
    inset: auto 0 0;
    padding: 5px 10px;
    background: var(--paper);
    color: var(--ink);
    font-size: 0.75rem;
  }
</style>
