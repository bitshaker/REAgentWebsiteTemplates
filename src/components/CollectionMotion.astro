<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const elements = document.querySelectorAll<HTMLElement>(
    '.collection-home [data-reveal]',
  );
  // Content stays visible without JavaScript; animation is applied only on entry.
  const animations = new Set<Animation>();
  let observer: IntersectionObserver | undefined;
  if (!reduced.matches) {
    observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting || reduced.matches) return;
          const animation = (entry.target as HTMLElement).animate(
            [
              { opacity: 0.35, transform: 'translateY(38px)' },
              { opacity: 1, transform: 'translateY(0)' },
            ],
            { duration: 1000, easing: 'cubic-bezier(.16,1,.3,1)' },
          );
          animations.add(animation);
          void animation.finished.then(
            () => animations.delete(animation),
            () => animations.delete(animation),
          );
          observer?.unobserve(entry.target);
        });
      },
      { threshold: 0.12 },
    );
    elements.forEach((el) => observer?.observe(el));
  }
  reduced.addEventListener('change', () => {
    if (!reduced.matches) return;
    observer?.disconnect();
    animations.forEach((animation) => animation.cancel());
    animations.clear();
  });
  const bars = document.querySelectorAll<HTMLElement>(
    '[data-reading-progress]',
  );
  let pendingFrame = 0;
  let total = 0;
  const update = () => {
    pendingFrame = 0;
    bars.forEach(
      (bar) =>
        (bar.style.transform = `scaleX(${total > 0 ? scrollY / total : 0})`),
    );
  };
  const schedule = () => {
    if (!pendingFrame) pendingFrame = requestAnimationFrame(update);
  };
  const measure = () => {
    total = document.documentElement.scrollHeight - innerHeight;
    schedule();
  };
  if (bars.length) {
    document.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', measure);
    new ResizeObserver(measure).observe(document.body);
    measure();
  }
</script>
