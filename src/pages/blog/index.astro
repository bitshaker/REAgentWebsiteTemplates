---
import Layout from '../../layouts/Layout.astro';
import { publishedPosts } from '../../lib/posts';
const posts = await publishedPosts();
---

<Layout title="The journal">
  <section class="section wrap">
    <div class="page-head">
      <p class="eyebrow">A little local perspective</p>
      <h1>
        Notes for
        <br />
        your next chapter.
      </h1>
      <p>
        Useful ideas, thoughtful questions, and a clearer view of the buying and
        selling process.
      </p>
    </div>
    <ul class="article-list">
      {posts.map((post) => (
        <li>
          <p class="eyebrow">
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                timeZone: 'UTC',
              })}
            </time>
          </p>
          <h2>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          </h2>
          <p>{post.data.description}</p>
        </li>
      ))}
    </ul>
    {posts.length === 0 && <p>New journal entries are on the way.</p>}
  </section>
</Layout>
