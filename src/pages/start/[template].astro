---
import CatalogSetup from '../../components/CatalogSetup.astro';
export function getStaticPaths() {
  const manifests = import.meta.glob('../../../templates/*/template.json', {
    eager: true,
    import: 'default',
  }) as Record<string, { id: string; name: string }>;
  return Object.values(manifests).map((design) => ({
    params: { template: design.id },
    props: { design },
  }));
}
const { design } = Astro.props;
---

<CatalogSetup {design} />
