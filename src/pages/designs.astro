---
import { sitePath } from '../lib/site';
import Layout from '../layouts/Layout.astro';
const designFiles = import.meta.glob('../../templates/*/{Home.astro,pages.ts}');
const themeFiles = import.meta.glob('../../templates/*/theme.css', {
  query: '?inline',
});
const designs = (
  Object.values(
    import.meta.glob('../../templates/*/template.json', {
      eager: true,
      import: 'default',
    }),
  ) as {
    id: string;
    name: string;
    description: string;
    featured?: boolean;
    order?: number;
  }[]
)
  .filter(
    ({ id, featured }) =>
      featured === true &&
      `../../templates/${id}/theme.css` in themeFiles &&
      ['Home.astro', 'pages.ts'].every(
        (file) => `../../templates/${id}/${file}` in designFiles,
      ),
  )
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99));
const previews = import.meta.glob('../../templates/*/preview.jpg', {
  eager: true,
  query: '?url',
  import: 'default',
}) as Record<string, string>;
const heroImages = import.meta.glob('../../templates/*/media/hero.jpg', {
  eager: true,
  query: '?url',
  import: 'default',
}) as Record<string, string>;
---

<Layout title="Choose your design" noindex catalog>
  <section class="section wrap">
    <h1>Choose a design</h1>
    <p class="catalog-intro">
      Preview a design, then choose the one you want to use.
    </p>
    <p>
      <a class="button" href={sitePath('/start/')}>
        How to get your site ↗
      </a>
    </p>
    <div class="cards">
      {designs.map((d) => (
        <article class="card">
          <a
            class="design-preview-link"
            href={sitePath(`/preview/${d.id}/`)}
            aria-label={`Preview ${d.name}`}
          >
            <img
              src={
                previews[`../../templates/${d.id}/preview.jpg`] ??
                heroImages[`../../templates/${d.id}/media/hero.jpg`] ??
                sitePath('/images/architecture.svg')
              }
              alt=""
              width="1440"
              height="900"
              class="design-preview"
              loading="lazy"
            />
          </a>
          <h2>{d.name}</h2>
          <p class="card-description">{d.description}</p>
          <div class="design-actions">
            <a
              class="catalog-action preview-action"
              href={sitePath(`/preview/${d.id}/`)}
              aria-label={`Preview ${d.name} design`}
            >
              Preview design <span aria-hidden="true">↗</span>
            </a>
            <a
              class="catalog-action use-action"
              href={sitePath(`/start/${d.id}/`)}
              aria-label={`Use ${d.name} design`}
            >
              Use this design <span aria-hidden="true">↗</span>
            </a>
          </div>
          <details class="page-previews">
            <summary aria-label={`Preview individual pages for ${d.name}`}>
              Preview individual pages{' '}
              <svg
                width="16"
                height="16"
                viewBox="0 0 16 16"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="m4 6 4 4 4-4"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
              </svg>
            </summary>
            <nav class="page-samples" aria-label={`${d.name} page previews`}>
              {Object.entries({
                buyers: 'Buying',
                sellers: 'Selling',
                about: 'About',
                blog: 'Journal',
                contact: 'Contact',
              }).map(([page, label]) => (
                <a href={sitePath(`/preview/${d.id}/${page}/`)}>
                  {label}
                  <span aria-hidden="true">↗</span>
                </a>
              ))}
            </nav>
          </details>
        </article>
      ))}
    </div>
  </section>
</Layout>

<style>
  .section.wrap {
    padding: 90px 5%;
  }
  h1 {
    font-family: var(--font-sans);
    font-size: clamp(3rem, 6vw, 6rem);
    letter-spacing: -0.07em;
    line-height: 0.95;
    margin-bottom: 35px;
  }
  .cards {
    grid-template-columns: 1fr 1fr;
    gap: 70px 32px;
    margin-top: 70px;
  }
  .card h2 {
    font-family: var(--font-sans);
    font-size: 2.3rem;
    letter-spacing: -0.05em;
    margin: 24px 0 14px;
  }
  .card-description {
    min-height: 3.4em;
    margin-bottom: 24px;
  }
  .design-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .catalog-action {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding: 12px 10px;
    border: 1px solid var(--ink);
    text-decoration: none;
    font-size: 0.78rem;
    line-height: 1.3;
    white-space: nowrap;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .use-action {
    background: var(--ink);
    color: var(--paper);
  }
  .preview-action:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .use-action:hover {
    background: var(--paper);
    color: var(--ink);
  }
  .page-previews {
    margin-top: 16px;
  }
  .page-previews summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 48px;
    padding: 10px 0;
    cursor: pointer;
    list-style: none;
    color: var(--muted);
    font-size: 0.8rem;
  }
  .page-previews summary::-webkit-details-marker {
    display: none;
  }
  .page-previews summary:hover {
    color: var(--ink);
  }
  .page-previews summary svg {
    flex-shrink: 0;
    transition: transform 0.2s;
  }
  .page-previews[open] summary svg {
    transform: rotate(180deg);
  }

  .card p {
    max-width: 480px;
  }
  .design-preview-link {
    display: block;
    text-decoration: none;
  }
  .design-preview {
    transition: filter 0.4s;
  }
  .card:hover .design-preview {
    filter: brightness(0.94);
  }
  @media (max-width: 760px) {
    .cards {
      grid-template-columns: 1fr;
      gap: 45px;
    }
    .section.wrap {
      padding-top: 55px;
    }
  }
  .catalog-intro {
    max-width: 700px;
  }
  .design-preview {
    width: 100%;
    height: auto;
    aspect-ratio: 1.6;
    object-fit: contain;
    object-position: center top;
    background: var(--paper);
  }
  .page-samples {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    padding: 4px 0 0;
  }
  .page-samples a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 44px;
    padding: 10px 14px;
    border: 1px solid var(--line);
    text-decoration: none;
    font-size: 0.8rem;
    background: #ffffff30;
  }
  .page-samples a:hover {
    border-color: var(--ink);
    background: #ffffff70;
  }
  .page-samples a:last-child {
    grid-column: 1/-1;
  }
  .card {
    padding: 0;
    border: 0;
    display: flex;
    flex-direction: column;
    align-self: start;
  }
  @media (max-width: 350px) {
    .design-actions {
      grid-template-columns: 1fr;
    }
  }
</style>
