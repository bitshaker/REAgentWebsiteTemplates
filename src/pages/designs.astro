---
import { sitePath } from '../lib/site';
import Layout from '../layouts/Layout.astro';
const designFiles = import.meta.glob('../../templates/*/{Home.astro,pages.ts}');
const themeFiles = import.meta.glob('../../templates/*/theme.css', {
  query: '?inline',
});
const designs = (
  Object.values(
    import.meta.glob('../../templates/*/template.json', {
      eager: true,
      import: 'default',
    }),
  ) as { id: string; name: string; description: string }[]
).filter(
  ({ id }) =>
    `../../templates/${id}/theme.css` in themeFiles &&
    ['Home.astro', 'pages.ts'].every(
      (file) => `../../templates/${id}/${file}` in designFiles,
    ),
);
const previews = import.meta.glob('../../templates/*/preview.jpg', {
  eager: true,
  query: '?url',
  import: 'default',
}) as Record<string, string>;
---

<Layout title="Choose your design" noindex catalog>
  <section class="section wrap">
    <p class="eyebrow">The design collection</p>
    <h1>
      One foundation.
      <br />
      Your kind of home.
    </h1>
    <p>
      {designs.length} directions. Shared pages, a simple journal, and a site
      that feels like you.
    </p>
    <p class="catalog-intro">
      Browse the complete sample sites, then take home just your favorite
      design. Your own repository, your own hosting, your own software agent.
    </p>
    <p>
      <a class="button" href={sitePath('/start/')}>
        How to get your site ↗
      </a>
    </p>
    <div class="cards">
      {designs.map((d, i) => (
        <article class="card">
          <p class="number">
            {String(i + 1).padStart(2, '0')} / THE COLLECTION
          </p>
          <img
            src={
              previews[`../../templates/${d.id}/preview.jpg`] ??
              sitePath('/images/architecture.svg')
            }
            alt=""
            width="750"
            height="455"
            class="design-preview"
            loading="lazy"
          />
          <h2 style="margin-top:25px">{d.name}</h2>
          <p>{d.description}</p>
          <a class="button" href={sitePath(`/preview/${d.id}/`)}>
            Explore {d.name} ↗
          </a>
          <nav class="page-samples" aria-label={`${d.name} page previews`}>
            {Object.entries({
              buyers: 'Buy',
              sellers: 'Sell',
              about: 'About',
              blog: 'Journal',
              contact: 'Contact',
            }).map(([page, label]) => (
              <a href={sitePath(`/preview/${d.id}/${page}/`)}>{label}</a>
            ))}
          </nav>
          <p>
            <a class="button" href={sitePath(`/start/${d.id}/`)}>
              Use {d.name} ↗
            </a>
          </p>
        </article>
      ))}
    </div>
  </section>
</Layout>

<style>
  .section.wrap {
    padding: 70px 5%;
  }
  .catalog-intro {
    max-width: 700px;
  }
  .design-preview {
    width: 100%;
    height: auto;
    aspect-ratio: 1.65;
    object-fit: cover;
    object-position: center top;
    background: var(--paper);
  }
  .page-samples {
    display: flex;
    flex-wrap: wrap;
    gap: 0 14px;
    margin-top: 8px;
  }
  .page-samples a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    font-size: 0.86rem;
  }
  .card {
    padding-inline: 0;
  }
</style>
