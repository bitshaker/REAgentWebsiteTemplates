---
import CatalogLinks from '../components/CatalogLinks.astro';
import { sitePath, siteOrigin } from '../lib/site';
import { agent, phoneHref } from '../lib/agent';
import { designHref } from '../lib/design-pages';
import '../styles/base.css';
import '../styles/fonts.css';
import '../styles/collection.css';
import CollectionMotion from '../components/CollectionMotion.astro';
import { theme as defaultTheme } from '../selected-template';
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  article?: boolean;
  previewBase?: string;
  theme?: string;
  catalog?: boolean;
}
const {
  title,
  description = agent.seoDescription,
  noindex = false,
  article = false,
  previewBase = '',
  theme = defaultTheme,
  catalog = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, siteOrigin).href;
const collection = !catalog && /--collection-design:\s*1/.test(theme);
const isHome = Astro.url.pathname === designHref('/', previewBase);
const siteBrand = catalog ? 'The Real Estate Design Collection' : agent.brand;
const nav = catalog
  ? [
      ['Designs', '/designs/'],
      ['Get started ↗', '/start/'],
    ]
  : [
      ['About', '/about/'],
      ['Buy', '/buyers/'],
      ['Sell', '/sellers/'],
      ['Journal', '/blog/'],
      ['Get in touch ↗', '/contact/'],
    ];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  name: agent.name,
  url: agent.siteUrl,
  telephone: agent.phone,
  email: agent.email,
  description: agent.seoDescription,
  areaServed: agent.serviceAreas,
  address: {
    '@type': 'PostalAddress',
    streetAddress: agent.address.street,
    addressLocality: agent.address.city,
    addressRegion: agent.address.region,
    postalCode: agent.address.postalCode,
    addressCountry: agent.address.country,
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <style is:global set:html={theme} />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | {siteBrand}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={noindex || agent.demo ? 'noindex, nofollow' : 'index, follow'}
    />
    <meta property="og:title" content={`${title} | ${siteBrand}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta
      property="og:image"
      content={new URL(sitePath('/images/social-card.png'), siteOrigin).href}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={sitePath('/favicon.svg')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${agent.brand} journal`}
      href={sitePath('/rss.xml')}
    />
    {!agent.demo && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(schema).replace(/</g, '\u003c')}
      />
    )}
  </head>
  <body
    class:list={{
      'collection-site': collection,
      'home-view': collection && isHome,
      'has-call-bar': !catalog,
    }}
  >
    {collection && (
      <div
        class="reading-progress"
        data-reading-progress
        aria-hidden="true"
      ></div>
    )}
    <a class="skip" href="#main">
      Skip to content
    </a>
    {agent.demo && (
      <div class="demo">
        <span class="demo-message">
          Demonstration website · Sample identity and content
        </span>{' '}
        <CatalogLinks {previewBase} />
      </div>
    )}
    <header class="wrap">
      <nav class="site-nav" aria-label="Main navigation">
        <a class="brand" href={designHref('/', previewBase)}>
          {siteBrand}
          <span aria-hidden="true"> /</span>
        </a>
        <div class="nav-links">
          {nav.map(([label, href]) => (
            <a
              href={designHref(href, previewBase)}
              aria-current={
                Astro.url.pathname === designHref(href, previewBase)
                  ? 'page'
                  : undefined
              }
            >
              {label}
            </a>
          ))}
        </div>
        {!catalog && (
          <a class="nav-call" href={phoneHref}>
            <span>Call</span>
            <strong>{agent.phone}</strong>
          </a>
        )}
        {collection && (
          <details class="mobile-menu">
            <summary>Menu</summary>
            <div class="mobile-menu-panel">
              {nav.map(([label, href]) => (
                <a href={designHref(href, previewBase)}>{label}</a>
              ))}
            </div>
          </details>
        )}
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    {collection && <CollectionMotion />}
    {catalog ? (
      <footer class="site-footer">
        <div class="wrap">
          <p>
            Sample sites use a demonstration identity.{' '}
            <a href={sitePath('/start/')}>Start your own site ↗</a>
          </p>
        </div>
      </footer>
    ) : (
      <footer class="site-footer">
        <div class="wrap">
          <div class="footer-top">
            <div>
              <a class="brand" href={designHref('/', previewBase)}>
                {agent.brand}
              </a>
              <p>{agent.tagline}</p>
            </div>
            <div>
              <strong>{agent.name}</strong>
              <br />
              {agent.brokerage}
              <br />
              License: {agent.license}
            </div>
            <div>
              <a class="footer-call" href={phoneHref}>
                Call {agent.phone}
              </a>
              <br />
              <a href={`mailto:${agent.email}`}>{agent.email}</a>
              <br />
              {agent.address.street}
              <br />
              {agent.address.city}, {agent.address.region}{' '}
              {agent.address.postalCode}
            </div>
          </div>
          <div class="footer-bottom">
            <span>
              © {new Date().getFullYear()} {agent.brand}. Equal Housing
              Opportunity.
            </span>
            <span>
              <a href={sitePath('/privacy/')}>Privacy</a> ·{' '}
              <a href={sitePath('/accessibility/')}>Accessibility</a>
            </span>
          </div>
        </div>
      </footer>
    )}
    {!catalog && (
      <aside class="mobile-call-bar" aria-label="Call your agent">
        <p>
          Questions about
          <br />
          your move?
        </p>
        <a href={phoneHref}>
          <span>Call {agent.name}</span>
          <strong>{agent.phone}</strong>
        </a>
      </aside>
    )}
  </body>
</html>
