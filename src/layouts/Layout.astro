---
import CatalogLinks from '../components/CatalogLinks.astro';
import { sitePath, siteOrigin, isCatalog } from '../lib/site';
import { agent, phoneHref } from '../lib/agent';
import { designHref } from '../lib/design-pages';
import '../styles/base.css';
import '../styles/fonts.css';
import '../styles/collection.css';
import CollectionMotion from '../components/CollectionMotion.astro';
import { theme as defaultTheme } from '../selected-template';
import { design as defaultDesign } from '../selected-template';
import { agentPortrait } from '../lib/portrait';
import type { DesignPages } from '../lib/design-pages';
import { absoluteUrl, pageSeo, structuredData, type Article } from '../lib/seo';
import {
  indexablePath,
  withoutBase,
  serializeSchema,
} from '../lib/seo-policy.mjs';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  post?: Article;
  design?: DesignPages;
  previewBase?: string;
  theme?: string;
  catalog?: boolean;
}
const {
  title: customTitle,
  description: customDescription,
  noindex = false,
  post,
  design = defaultDesign,
  previewBase = '',
  theme = defaultTheme,
  catalog = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, siteOrigin).href;
const path = withoutBase(Astro.url.pathname, import.meta.env.BASE_URL);
const pagePath = previewBase ? path.slice(previewBase.length) || '/' : path;
const seo = pageSeo(pagePath, design, post);
const title = customTitle ?? seo.title;
const description = customDescription ?? seo.description;
const pageTitle = `${title} | ${catalog ? 'The Real Estate Design Collection' : agent.brand}`;
const hidden =
  noindex ||
  agent.demo ||
  isCatalog ||
  catalog ||
  Boolean(previewBase) ||
  !indexablePath(path);
const image = absoluteUrl(seo.image.src);
const schema = hidden
  ? undefined
  : structuredData({
      canonical,
      title: pageTitle,
      description,
      type: seo.type,
      breadcrumbs: seo.breadcrumbs,
      post,
      portraitUrl: agent.portraitUrl ? (await agentPortrait())?.src : undefined,
    });
const collection = !catalog && /--collection-design:\s*1/.test(theme);
const isHome = Astro.url.pathname === designHref('/', previewBase);
const siteBrand = catalog ? 'The Real Estate Design Collection' : agent.brand;
const nav = catalog
  ? [
      ['Designs', '/designs/'],
      ['Get started ↗', '/start/'],
    ]
  : [
      ['About', '/about/'],
      ['Buy', '/buyers/'],
      ['Sell', '/sellers/'],
      ['Journal', '/blog/'],
      ['Get in touch ↗', '/contact/'],
    ];
---

<!doctype html>
<html lang="en">
  <head>
    <style is:global set:html={theme} />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={
        hidden ? 'noindex, follow' : 'index, follow, max-image-preview:large'
      }
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={post ? 'article' : 'website'} />
    <meta property="og:site_name" content={siteBrand} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={seo.image.alt} />
    {seo.image.width && (
      <meta property="og:image:width" content={String(seo.image.width)} />
    )}
    {seo.image.height && (
      <meta property="og:image:height" content={String(seo.image.height)} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={seo.image.alt} />
    {post && (
      <>
        <meta name="author" content={post.data.author || agent.name} />
        <meta
          property="article:published_time"
          content={post.data.date.toISOString()}
        />
        <meta
          property="article:modified_time"
          content={(post.data.updated ?? post.data.date).toISOString()}
        />
      </>
    )}
    {isHome && !catalog && (
      <link
        rel="preload"
        as="image"
        href={design.homeArt.src}
        imagesrcset={design.homeArt.srcset || undefined}
        imagesizes={design.homeArt.srcset ? '100vw' : undefined}
        fetchpriority="high"
      />
    )}
    {!agent.demo && !isCatalog && !catalog && !previewBase && (
      <link
        rel="sitemap"
        type="application/xml"
        href={sitePath('/sitemap-index.xml')}
      />
    )}
    <link rel="icon" type="image/svg+xml" href={sitePath('/favicon.svg')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${agent.brand} journal`}
      href={sitePath('/rss.xml')}
    />
    {schema && (
      <script type="application/ld+json" set:html={serializeSchema(schema)} />
    )}
  </head>
  <body
    class:list={{
      'collection-site': collection,
      'home-view': collection && isHome,
      'has-call-bar': !catalog,
    }}
  >
    {collection && (
      <div
        class="reading-progress"
        data-reading-progress
        aria-hidden="true"
      ></div>
    )}
    <a class="skip" href="#main">
      Skip to content
    </a>
    {agent.demo && (
      <div class="demo">
        <span class="demo-message">
          Demonstration website · Sample identity and content
        </span>{' '}
        <CatalogLinks {previewBase} />
      </div>
    )}
    <header class="wrap">
      <nav class="site-nav" aria-label="Main navigation">
        <a class="brand" href={designHref('/', previewBase)}>
          {siteBrand}
          <span aria-hidden="true"> /</span>
        </a>
        <div class="nav-links">
          {nav.map(([label, href]) => (
            <a
              href={designHref(href, previewBase)}
              aria-current={
                Astro.url.pathname === designHref(href, previewBase)
                  ? 'page'
                  : undefined
              }
            >
              {label}
            </a>
          ))}
        </div>
        {!catalog && (
          <a class="nav-call" href={phoneHref}>
            <span>Call</span>
            <strong>{agent.phone}</strong>
          </a>
        )}
        {collection && (
          <details class="mobile-menu">
            <summary>Menu</summary>
            <div class="mobile-menu-panel">
              {nav.map(([label, href]) => (
                <a
                  href={designHref(href, previewBase)}
                  aria-current={
                    Astro.url.pathname === designHref(href, previewBase)
                      ? 'page'
                      : undefined
                  }
                >
                  {label}
                </a>
              ))}
            </div>
          </details>
        )}
      </nav>
    </header>
    <main id="main" tabindex="-1">
      {!catalog && indexablePath(pagePath) && seo.breadcrumbs.length > 0 && (
        <nav class="breadcrumbs wrap" aria-label="Breadcrumb">
          <ol>
            {seo.breadcrumbs.map((crumb, index) => (
              <li>
                {index === seo.breadcrumbs.length - 1 ? (
                  <span aria-current="page">{crumb.name}</span>
                ) : (
                  <a href={designHref(crumb.path, previewBase)}>{crumb.name}</a>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )}
      <slot />
    </main>
    {collection && <CollectionMotion />}
    {catalog ? (
      <footer class="site-footer">
        <div class="wrap">
          <p>
            Sample sites use a demonstration identity.{' '}
            <a href={sitePath('/start/')}>Start your own site ↗</a>
          </p>
        </div>
      </footer>
    ) : (
      <footer class="site-footer">
        <div class="wrap">
          <div class="footer-top">
            <div>
              <a class="brand" href={designHref('/', previewBase)}>
                {agent.brand}
              </a>
              <p>{agent.tagline}</p>
            </div>
            <div>
              <strong>{agent.name}</strong>
              <br />
              {agent.brokerage}
              <br />
              License: {agent.license}
            </div>
            <div>
              <a class="footer-call" href={phoneHref}>
                Call {agent.phone}
              </a>
              <br />
              <a href={`mailto:${agent.email}`}>{agent.email}</a>
              <br />
              {agent.address.street}
              <br />
              {agent.address.city}, {agent.address.region}{' '}
              {agent.address.postalCode}
            </div>
          </div>
          <div class="footer-bottom">
            <span>
              © {new Date().getFullYear()} {agent.brand}. Equal Housing
              Opportunity.
            </span>
            <span>
              <a href={sitePath('/privacy/')}>Privacy</a> ·{' '}
              <a href={sitePath('/accessibility/')}>Accessibility</a>
            </span>
          </div>
        </div>
      </footer>
    )}
    {!catalog && (
      <aside class="mobile-call-bar" aria-label="Call your agent">
        <p>
          Questions about
          <br />
          your move?
        </p>
        <a href={phoneHref}>
          <span>Call {agent.name}</span>
          <strong>{agent.phone}</strong>
        </a>
      </aside>
    )}
  </body>
</html>

<script>
  document
    .querySelectorAll<HTMLDetailsElement>('.mobile-menu')
    .forEach((menu) => {
      const toggle = menu.querySelector('summary')!;
      menu.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu.open) {
          event.preventDefault();
          menu.open = false;
          toggle.focus();
        }
      });
      menu.addEventListener('focusout', (event) => {
        if (
          event.relatedTarget instanceof Node &&
          !menu.contains(event.relatedTarget)
        )
          menu.open = false;
      });
      document.addEventListener('click', (event) => {
        if (event.target instanceof Node && !menu.contains(event.target))
          menu.open = false;
      });
    });
</script>
